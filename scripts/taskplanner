scenario_owner_state_root() {
  # Resolve the one bind-mounted ScenarioStore directory from Compose instead
  # of duplicating an environment/default path in launcher code. This makes
  # the persisted selection portable across a changed local state root.
  taskplanner_owner_scenario_state_root
}

prepare_scenario_owner_state() {
  local state_root
  state_root="$(
    scenario_owner_state_root
  )"
  [[ -n "${state_root}" ]] ||
    die "cannot resolve the ScenarioStore state directory"
  if [[ "${DRY_RUN}" == "true" ]]; then
    print_command install -d -m 0700 "${state_root}"
    return 0
  fi
  install -d -m 0700 "${state_root}" 2>/dev/null ||
    die "ScenarioStore state directory cannot be created: ${state_root}"
  [[ -w "${state_root}" ]] ||
    die "ScenarioStore state is not writable by UID $(id -u): ${state_root}"
}

restore_persisted_scenario_default() {
  # ScenarioStore owns the selected revision. At a cold owner-set start every
  # static launch default must agree with its last-good selection before the
  # first node constructs procedure-specific state. This reads a tiny,
  # owner-local JSON preference only; validation of its path/revision remains
  # in ScenarioStore and a malformed preference simply falls back to the
  # mode's configured default.
  local mode="$1"
  local state_root selection_path bundle_name
  case "${mode}" in
    live|llm-surgeon) ;;
    *) return 0 ;;
  esac
  [[ "${TASKPLANNER_SCENARIO_RESTORE_PERSISTED_SELECTION:-true}" == "true" ]] ||
    return 0
  state_root="$(scenario_owner_state_root)" ||
    die "cannot resolve the ScenarioStore state directory"
  [[ -n "${state_root}" ]] || return 0
  selection_path="${state_root}/selected_bundle.json"
  bundle_name="$(
    python3 "${ROOT_DIR}/scripts/taskplanner_scenario_selection.py" \
      "${selection_path}"
  )"
  [[ -n "${bundle_name}" ]] || return 0
  case "${mode}" in
    live) export TASKPLANNER_LIVE_DEFAULT_BUNDLE="${bundle_name}" ;;
    llm-surgeon) export TASKPLANNER_DEFAULT_BUNDLE="${bundle_name}" ;;
  esac
  printf 'Taskplanner %s: restored ScenarioStore selection %s\n' \
    "${mode}" "${bundle_name}"
}

prepare_tts_runtime() {
  local -a tts_contract
  mapfile -t tts_contract < <(
    "${COMPOSE[@]}" --profile live --profile ops config --format json |
      python3 -c '
import json
import sys

config = json.load(sys.stdin)
service = config["services"]["taskplanner-tts"]
sources = {
    volume["target"]: volume["source"]
    for volume in service.get("volumes", [])
    if volume.get("type") == "bind"
}
for target in (
    "/models/supertonic-3",
    "/taskplanner-tts-state",
    "/taskplanner-tts-cache",
):
    if target not in sources:
        raise SystemExit(f"taskplanner-tts bind mount is missing: {target}")
    print(sources[target])
print(service.get("environment", {}).get("TASKPLANNER_TTS_VOICE_ID", "F1"))
'
  )
  if [[ "${#tts_contract[@]}" -ne 4 ]]; then
    printf 'warning: cannot resolve the taskplanner-tts model/state/cache contract\n' >&2
    return 1
  fi

  local model_root="${tts_contract[0]}"
  local state_root="${tts_contract[1]}"
  local cache_root="${tts_contract[2]}"
  local voice_id="${tts_contract[3]}"
  if [[ "${DRY_RUN}" == "true" ]]; then
    print_command test -f "${model_root}/onnx/tts.json"
    print_command test -f "${model_root}/voice_styles/${voice_id}.json"
    print_command mkdir -p "${state_root}" "${cache_root}"
    TTS_RUNTIME_PREFLIGHT_DONE=true
    return 0
  fi

  [[ -f "${model_root}/onnx/tts.json" ]] || {
    printf 'warning: Supertonic model is missing: %s\n' \
      "${model_root}/onnx/tts.json" >&2
    return 1
  }
  [[ -f "${model_root}/voice_styles/${voice_id}.json" ]] || {
    printf 'warning: Supertonic voice is missing: %s\n' \
      "${model_root}/voice_styles/${voice_id}.json" >&2
    return 1
  }
  mkdir -p "${state_root}" "${cache_root}" 2>/dev/null || {
    printf 'warning: TTS state/cache directories cannot be created\n' >&2
    return 1
  }
  [[ -w "${state_root}" ]] || {
    printf 'warning: TTS state directory is not writable by UID %s: %s\n' \
      "$(id -u)" "${state_root}" >&2
    return 1
  }
  [[ -w "${cache_root}" ]] || {
    printf 'warning: TTS cache directory is not writable by UID %s: %s\n' \
      "$(id -u)" "${cache_root}" >&2
    return 1
  }

  local user_runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  local pipewire_socket="${TASKPLANNER_PIPEWIRE_SOCKET:-${user_runtime_dir}/pipewire-0}"
  [[ -S "${pipewire_socket}" ]] || {
    printf 'warning: Ubuntu PipeWire output is unavailable: %s\n' \
      "${pipewire_socket}" >&2
    return 1
  }
  TTS_RUNTIME_PREFLIGHT_DONE=true
}

ensure_live_tts_sidecar() {
  # The TTS model is an independently deployable Live owner.  Never make its
  # local model/device readiness a prerequisite for the Action/Service path:
  # Compose starts it asynchronously and the owner health endpoint reports
  # whether Supertonic prewarm eventually succeeded.
  local mode="$1"
  shift
  mode_uses_tts_sidecar "${mode}" || return 0
  # Compose creates a missing bind source as root. Prepare the two writable
  # paths as the operator before first deployment, but do not add this probe
  # to the normal fast path when a TTS container already exists.
  if [[ "${DRY_RUN}" != "true" &&
        "${TTS_RUNTIME_PREFLIGHT_DONE}" != "true" ]]; then
    local existing_tts_container
    existing_tts_container="$(
      "${COMPOSE[@]}" --profile live --profile ops ps -aq taskplanner-tts 2>/dev/null || true
    )"
    if [[ -z "${existing_tts_container}" ]] && ! prepare_tts_runtime; then
      printf 'warning: TTS preflight is unavailable; attempting the independent TTS owner anyway\n' >&2
    fi
  fi
  run_best_effort \
    "TTS sidecar did not start; playback remains independently unavailable" \
    "${COMPOSE[@]}" --profile live --profile ops \
    up -d "$@" taskplanner-tts
}

ensure_surgimate_sidecar() {
  # The static monitor is visible in the owner registry but intentionally
  # excluded from its core-owner service plan. Start it during a cold mode
  # convergence only; warm core paths and resume preserve an explicit Debug
  # stop instead of silently reviving the browser application.
  local mode="$1"
  taskplanner_owner_resolve surgimate "${mode}" || return 0
  [[ "${TASKPLANNER_OWNER_MODE_SUPPORTED}" == "true" &&
     "${TASKPLANNER_OWNER_ENABLED}" == "true" ]] || return 0
  if [[ "${DRY_RUN}" == "true" ]]; then
    taskplanner_start_sidecar_owner "${mode}" surgimate
    return
  fi
  run_best_effort \
    "SurgiMate did not start; Taskplanner remains available and the sidecar can be retried from Debug" \
    taskplanner_start_sidecar_owner "${mode}" surgimate
}

assert_debug_runtime_is_exclusive() {
  local active_services
  active_services="$(
    "${COMPOSE[@]}" "${ALL_PROFILE_ARGS[@]}" ps --status running --services
  )"
  if grep -Eq '^(taskplanner-state-core|shadow-runner)$' <<<"${active_services}"; then
    die "a full Taskplanner runtime is active; stop it before starting Debug Mode"
  fi
}

start_operational_asr_capture() {
  local timeout_sec="${TASKPLANNER_ASR_START_TIMEOUT_SEC:-20}"
  if [[ ! "${timeout_sec}" =~ ^[1-9][0-9]*$ ]]; then
    die "TASKPLANNER_ASR_START_TIMEOUT_SEC must be a positive integer"
  fi
  local request="{operation: start, device_id: -1, server_url: '', route_policy: ''}"
  local start_script
  start_script='set -euo pipefail
# ROS setup scripts probe optional variables before defining them. Keep
# nounset disabled only while sourcing the reviewed environments.
set +u
source /opt/ros/jazzy/setup.bash
source /opt/btops_ws/install/setup.bash
source /workspaces/taskplanner_ws/install/docker/setup.bash
set -u
response="$(timeout "$1" ros2 service call /input/asr/control surgical_msgs/srv/AsrControl "$2")"
printf "%s\n" "$response"
# Warm Live restarts preserve an already-active capture session. Accept only
# the exact node response; every other rejection still fails.
grep -q "accepted=True" <<<"$response" ||
  grep -Fq "ASR microphone session is already active" <<<"$response"'

  if [[ "${DRY_RUN}" == "true" ]]; then
    print_command \
      "${COMPOSE[@]}" --profile live exec -T taskplanner-asr \
      bash -lc "${start_script}" taskplanner-asr-start "${timeout_sec}" "${request}"
    return 0
  fi

  "${COMPOSE[@]}" --profile live exec -T taskplanner-asr \
    bash -lc "${start_script}" taskplanner-asr-start "${timeout_sec}" "${request}"
}

prepare_debug_audio_runtime() {
  local user_runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  local pipewire_socket="${TASKPLANNER_PIPEWIRE_SOCKET:-${user_runtime_dir}/pipewire-0}"
  export TASKPLANNER_PIPEWIRE_SOCKET="${pipewire_socket}"
  if [[ "${DRY_RUN}" != "true" && ! -S "${pipewire_socket}" ]]; then
    die "Ubuntu PipeWire input is unavailable: ${pipewire_socket}"
  fi
}

prepare_surgery_record_secret() {
  local api_key_file="${PUZZLE_SURGERY_RECORD_API_KEY_FILE:-${HOME}/.config/taskplanner/secrets/puzzle-surgery-record-api-key}"
  export PUZZLE_SURGERY_RECORD_API_KEY_FILE="${api_key_file}"
  if [[ "${DRY_RUN}" == "true" ]]; then
    return
  fi
  if [[ ! -f "${api_key_file}" ]]; then
    die "surgery-record X-API-Key secret is unavailable: ${api_key_file}"
  fi
  if [[ ! -s "${api_key_file}" ]]; then
    die "surgery-record X-API-Key secret is empty: ${api_key_file}"
  fi
  local file_mode
  file_mode="$(stat -c '%a' "${api_key_file}")"
  if [[ "${file_mode}" != "600" ]]; then
    die "surgery-record X-API-Key secret must use mode 600: ${api_key_file}"
  fi
}

prepare_required_integrated_debug_observer() {
  # The integrated observer is now a normal owner-registry service.  It needs
  # only ROS/run-root state; USB audio, record secrets, PNU/VLM workers, and
  # network-settings write access are not observer prerequisites.
  return 0
}

action="${1:-help}"
shift || true
DRY_RUN=false
BUILD_ARGS=()
# BUILD_REQUESTED is deliberately ROS/colcon only. Docker image construction
# has a separate opt-in so an IDL/package build never pays for NInfer or other
# image rebuilds.
BUILD_REQUESTED=false
FORCE_REBUILD_REQUESTED=false
IMAGE_BUILD_REQUESTED=false
ENSURE_BUILD=false
REPLACE_ACTIVE_RUNTIME=false
ASR_RESTART_REQUIRE_ACTIVE_LIVE=false
TASKPLANNER_MODE_BUILD_PACKAGES=()
TASKPLANNER_CHANGED_BUILD_PACKAGES=()
TASKPLANNER_BUILD_PACKAGES=()
TASKPLANNER_MODE_BUILD_GENERATION=""

case "${action}" in
  help|-h|--help)
    usage
    ;;

  ui)
    exec "${ROOT_DIR}/scripts/taskplanner_ui.sh" "$@"
    ;;

  up)
    mode="live"
    if (($#)) && [[ "$1" != --* ]]; then
      mode="$1"
      shift
    fi
    validate_mode "${mode}"
    while (($#)); do
      case "$1" in
        --dry-run) DRY_RUN=true ;;
        --ros-build)
          BUILD_REQUESTED=true
          ;;
        --image-build)
          BUILD_ARGS=(--build)
          IMAGE_BUILD_REQUESTED=true
          export WEBAPP_INSTALL_ON_START=true
          ;;
        --build)
          # Compatibility spelling for an intentional full developer refresh.
          # Routine ROS ABI/IDL work should use --ros-build instead.
          BUILD_ARGS=(--build)
          BUILD_REQUESTED=true
          FORCE_REBUILD_REQUESTED=true
          IMAGE_BUILD_REQUESTED=true
          export WEBAPP_INSTALL_ON_START=true
          ;;
        --no-build)
          BUILD_ARGS=()
          BUILD_REQUESTED=false
          FORCE_REBUILD_REQUESTED=false
          IMAGE_BUILD_REQUESTED=false
          export WEBAPP_INSTALL_ON_START=false
          ;;
        --ensure-build)
          ENSURE_BUILD=true
          ;;
        --replace-active) REPLACE_ACTIVE_RUNTIME=true ;;
        -h|--help)
          usage
          exit 0
          ;;
        *) die "unknown up option: $1" ;;
      esac
      shift
    done
    if [[ "${REPLACE_ACTIVE_RUNTIME}" == "true" && "${mode}" != "debug" ]]; then
      die "--replace-active is valid only with debug"
    fi

    # Runtime services never mutate the shared colcon workspace themselves.
    # The common execution layer handles --build before any new reader starts.
    export TASKPLANNER_REBUILD_ON_START=false
    # Container profiles own this URI. A shell value often points at a host
    # path and would otherwise override the mode file with an unreadable DDS
    # configuration inside the container. Put deliberate overrides in .env.
    unset CYCLONEDDS_URI
    enforce_runtime_mode_contract "${mode}"
    acquire_launcher_lock
    compose_env_args "${mode}"
    taskplanner_compose_init
    trap cleanup_failed_runtime_start EXIT

    # The normal research hot path is deliberately small.  It only proves
    # that this mode still owns one running core, then restarts that core.  Do
    # not scan sources, plan packages, rebuild, recreate sidecars, or block on
    # ASR/VLM/camera/browser health just because a developer edited Python.
    # `--build` remains the explicit ABI/IDL/C++ path.
    if [[ "${BUILD_REQUESTED}" != "true" &&
          "${IMAGE_BUILD_REQUESTED}" != "true" &&
          "${ENSURE_BUILD}" != "true" ]] &&
        taskplanner_same_mode_core_running "${mode}"; then
      runtime_service="$(taskplanner_runtime_service_for_mode "${mode}")" ||
        die "could not resolve the ${mode} core service"
      # A warm restart has exactly one owner: state-core.  Do not quietly
      # revive a stopped ASR/TTS/split owner here; that makes a tiny source
      # edit fan out into unrelated work and hides an operator's deliberate
      # stop.  ScenarioStore's persisted selection is a small bootstrap hint
      # so the replacement core does not briefly construct the launch default
      # before receiving the retained snapshot.
      taskplanner_owner_prepare_persisted_scenario_bundle "${mode}"
      printf 'Taskplanner %s: restarting core only (no build or sidecar restart)\n' \
        "${mode}"
      taskplanner_cross_warm_restart_boundary "${mode}" "${runtime_service}"
      write_active_runtime_mode "${mode}"
      RUNTIME_FAILURE_CLEANUP_ARMED=false
      exit 0
    fi

    # Reboot recovery is intentionally narrower than a cold-mode convergence:
    # if the core is stopped but the existing UI/bridge/ASR control plane is
    # still alive, restore only this mode's stopped owners. Do not rebuild,
    # remove/recreate sidecars, or re-run global readiness just to recreate the
    # volatile /run marker.
    if [[ "${BUILD_REQUESTED}" != "true" &&
          "${IMAGE_BUILD_REQUESTED}" != "true" &&
          "${ENSURE_BUILD}" != "true" &&
          "${mode}" != "debug" ]] &&
        taskplanner_resume_candidate "${mode}"; then
      printf 'Taskplanner %s: resuming stopped core only (preserving sidecars)\n' \
        "${mode}"
      taskplanner_resume_stopped_core "${mode}"
      ensure_live_tts_sidecar "${mode}"
      exit 0
    fi

    ensure_runtime_control_service_best_effort
    INTEGRATED_DEBUG_ENABLED=false
    if mode_requires_integrated_debug_observer "${mode}"; then
      prepare_required_integrated_debug_observer
    fi
    if mode_requires_integrated_debug_observer "${mode}"; then
      # These are operational safety invariants, not user-tunable launcher
      # defaults. Shell overrides must not move the sidecar off the runtime DDS
      # domain, permit arming beside an active planner, or create a second PNU
      # bridge that competes with the operational runtime for output ownership.
      export TASKPLANNER_DEBUG_LOCK_TO_RUNTIME_NETWORK=true
      export TASKPLANNER_DEBUG_ALLOW_PLANNER_COEXISTENCE=false
      export ENABLE_PNU_DEBUG_PERCEPTION=false
    fi
    if [[ "${mode}" == "live" || "${mode}" == "replay" ]]; then
      # Operational PNU readiness means both pinned Tool/Blood models. Keep this
      # invariant even if a shell override is used for a separate Debug test.
      export PNU_WORKER_REQUIRED_ALGORITHMS=tool,blood
    fi
    public_rosbridge_enabled="false"
    local_media_rosbridge_enabled="false"
    rosbag_ui_audit_bridge_enabled="false"
    perception_backend="local"
    perception_provider=""
    perception_location=""
    perception_endpoint=""
    perception_selection_source="explicit_axes"
    local_rfdetr_enabled="false"
    local_object_perception_enabled="false"
    local_pnu_perception_enabled="false"
    debug_pnu_enabled="false"
    perception_mode_enabled="false"
    perception_consumer_service="taskplanner-perception"
    if [[ "${mode}" == "live" || "${mode}" == "llm-surgeon" || \
        "${mode}" == "replay" ]]; then
      public_rosbridge_enabled="$(
        compose_environment_value \
          "${mode}" public-rosbridge ENABLE_PUBLIC_ROSBRIDGE true
      )"
      case "${public_rosbridge_enabled}" in
        true|false) ;;
        *) die "ENABLE_PUBLIC_ROSBRIDGE must resolve to true or false" ;;
      esac
    fi
    if [[ "${mode}" == "live" ]]; then
      local_media_rosbridge_enabled="$(
        compose_environment_value \
          "${mode}" local-media-rosbridge ENABLE_LOCAL_MEDIA_ROSBRIDGE true
      )"
      case "${local_media_rosbridge_enabled}" in
        true|false) ;;
        *) die "ENABLE_LOCAL_MEDIA_ROSBRIDGE must resolve to true or false" ;;
      esac
    fi
    if [[ "${mode}" == "live" || "${mode}" == "replay" ]]; then
      rosbag_ui_audit_bridge_enabled="$(
        compose_environment_value \
          "${mode}" rosbag-ui-audit-bridge ENABLE_ROSBAG_UI_AUDIT_BRIDGE true
      )"
      case "${rosbag_ui_audit_bridge_enabled}" in
        true|false) ;;
        *) die "ENABLE_ROSBAG_UI_AUDIT_BRIDGE must resolve to true or false" ;;
      esac
    fi
    if ! resolve_optional_perception_start_plan "${mode}"; then
      # Do not turn optional perception configuration into a global readiness
      # gate. Its owner can report/fail independently while the deterministic
      # state, command, execution, and bridge owners remain usable.
      printf '%s\n' \
        "warning: perception startup plan is unavailable; skipping optional local perception workers while independent owners continue" \
        >&2
      perception_mode_enabled="false"
      perception_provider="disabled"
      perception_location="local"
      perception_endpoint=""
      local_rfdetr_enabled="false"
      local_object_perception_enabled="false"
      local_pnu_perception_enabled="false"
      debug_pnu_enabled="false"
    fi

    if [[ "${DRY_RUN}" != "true" ]]; then
      command -v docker >/dev/null 2>&1 || die "docker is not installed"
      if [[ "${INTEGRATED_DEBUG_ENABLED}" == "true" ]]; then
        "${COMPOSE[@]}" --profile "${mode}" --profile debug config --quiet
      else
        "${COMPOSE[@]}" --profile "${mode}" config --quiet
      fi
    fi

    # A build/install check belongs only to a cold start or the explicit
    # ABI/IDL/C++ path. A same-mode restart returned above without invoking it.
    ensure_runtime_install_contract "${mode}"

    # `--ensure-build` deliberately bypasses the *unchecked* fast path above,
    # but it is still a warm restart when the selected package contract proves
    # current.  Do not turn a successful owner/package check into a full mode
    # teardown merely because the user asked to verify it first.
    if [[ "${ENSURE_BUILD}" == "true" &&
          "${BUILD_REQUESTED}" != "true" &&
          "${IMAGE_BUILD_REQUESTED}" != "true" ]] &&
        taskplanner_same_mode_core_running "${mode}"; then
      runtime_service="$(taskplanner_runtime_service_for_mode "${mode}")" ||
        die "could not resolve the ${mode} core service"
      taskplanner_restore_missing_split_owners "${mode}"
      ensure_live_tts_sidecar "${mode}"
      printf 'Taskplanner %s: verified install; restarting core only\n' "${mode}"
      taskplanner_cross_warm_restart_boundary "${mode}" "${runtime_service}"
      write_active_runtime_mode "${mode}"
      RUNTIME_FAILURE_CLEANUP_ARMED=false
      exit 0
    fi

    # `--ros-build` asks for an ABI/IDL build, not a broad restart ritual. If
    # the selected package contracts are already valid (or were safely
    # baselined), leave a running core untouched; if only the volatile core is
    # stopped, use the narrow resume path. A first deployment still falls
    # through to normal convergence below.
    if [[ "${BUILD_REQUESTED}" == "true" &&
          "${FORCE_REBUILD_REQUESTED}" != "true" &&
          "${IMAGE_BUILD_REQUESTED}" != "true" &&
          "${#TASKPLANNER_BUILD_PACKAGES[@]}" == "0" ]]; then
      BUILD_REQUESTED=false
      if taskplanner_same_mode_core_running "${mode}"; then
        ensure_live_tts_sidecar "${mode}"
        printf 'Taskplanner %s: selected ROS packages are current; core left running\n' \
          "${mode}"
        RUNTIME_FAILURE_CLEANUP_ARMED=false
        exit 0
      fi
      if [[ "${mode}" != "debug" ]] && taskplanner_resume_candidate "${mode}"; then
        printf 'Taskplanner %s: selected ROS packages are current; resuming stopped core only\n' \
          "${mode}"
        taskplanner_resume_stopped_core "${mode}"
        ensure_live_tts_sidecar "${mode}"
        RUNTIME_FAILURE_CLEANUP_ARMED=false
        exit 0
      fi
    fi

    # Cold starts converge their selected services once.  Compose already
    # recreates a service when its rendered contract or explicitly rebuilt
    # image changed; forcing a recreate here churns independent ASR/UI/bridge
    # owners even when nothing about them changed.
    optional_recreate_args=()
    asr_recreate_args=()
    tts_recreate_args=()
    multicam_recreate_args=()
    public_rosbridge_recreate_args=()
    local_media_rosbridge_recreate_args=()
    rosbag_ui_audit_bridge_recreate_args=()
    mapfile -t split_owner_services < <(taskplanner_all_split_owner_services)

    if [[ "${mode}" == "live" || "${mode}" == "llm-surgeon" ]]; then
      prepare_vlm_reply_outbox_state "${mode}"
      prepare_execution_ledger_state "${mode}"
      prepare_scenario_owner_state
      restore_persisted_scenario_default "${mode}"
    fi
    if [[ "${mode}" == "live" ]]; then
      prepare_surgery_record_state
      prepare_rosbag_recording_state
      prepare_surgery_record_secret
    fi
    if mode_uses_operational_asr_sidecar "${mode}"; then
      prepare_operational_asr_run_root
    fi
    if mode_uses_tts_sidecar "${mode}"; then
      # A real model/device preflight is useful startup evidence, but audio is
      # an observer/presentation lane. Do not turn a missing PipeWire socket
      # or cache directory into a global Action/Service admission failure.
      if ! prepare_tts_runtime; then
        printf 'warning: TTS preflight is unavailable; Live will continue and the TTS owner will report its own readiness\n' >&2
      fi
    fi

    if [[ "${mode}" == "debug" ]]; then
      if [[ "${DRY_RUN}" != "true" && "${REPLACE_ACTIVE_RUNTIME}" != "true" ]]; then
        assert_debug_runtime_is_exclusive
      fi
      # Debug is a small independent pair: observer (including private
      # secured ROSBridge) and explicit control.  It does not inherit the
      # historical all-in-one Debug sidecars just because a researcher opened
      # an observation UI.
      taskplanner_select_debug_reset_services "${BUILD_REQUESTED}"
      debug_reset_services=("${TASKPLANNER_SELECTED_RESET_SERVICES[@]}")
      debug_reset_services+=("${split_owner_services[@]}")
      debug_reset_services+=(rosbag-ui-audit-bridge)
      if [[ "${BUILD_REQUESTED}" != "true" ]]; then
        # Do not remove web/VLM/record/network sidecars. Their ownership is
        # independent, and the Debug observer/control pair has no dependency
        # on them.
        debug_reset_services=(
          "${split_owner_services[@]}"
          shadow-runner
          taskplanner-asr
          rosbag-ui-audit-bridge
        )
      fi
      RUNTIME_FAILURE_CLEANUP_SERVICES=()
      verify_mode_replacement_execution_interlock
      RUNTIME_FAILURE_CLEANUP_ARMED=true
      # Preserve the old marker through preflight failures. Clear it only
      # after the final stopped-state gate, immediately before the stop.
      clear_active_runtime_mode
      taskplanner_compose_stop_remove "${debug_reset_services[@]}"
      taskplanner_build_selected_runtime "${mode}"
      # Keep the dashboard process alive across mode transitions. Runtime
      # status is authoritative and its configuration is mode-independent.
      refresh_webapp_if_stale --profile debug --profile owners
      run_or_print \
        "${COMPOSE[@]}" --profile debug --profile owners \
        up -d "${BUILD_ARGS[@]}" webapp
      mapfile -t debug_owner_services < <(
        taskplanner_owner_services_for_mode debug
      )
      ((${#debug_owner_services[@]} > 0)) ||
        die "runtime owner registry returned no debug services"
      run_or_print \
        "${COMPOSE[@]}" --profile debug --profile owners \
        up -d "${BUILD_ARGS[@]}" "${debug_owner_services[@]}"
      for owner_service in "${debug_owner_services[@]}"; do
        track_runtime_failure_cleanup_if_reset \
          "${owner_service}" "${debug_reset_services[@]}"
      done
      ensure_surgimate_sidecar "${mode}"
      taskplanner_finalize_runtime_readiness \
        "${mode}" false --profile debug --profile owners
      exit 0
    fi

    if [[ "${mode}" == "replay" ]]; then
      prepare_replay_run_root
    fi

    taskplanner_select_operational_reset_services \
      "${mode}" \
      "${BUILD_REQUESTED}" \
      "${local_object_perception_enabled}" \
      "${local_pnu_perception_enabled}"
    runtime_reset_services=("${TASKPLANNER_SELECTED_RESET_SERVICES[@]}")
    runtime_reset_services+=("${split_owner_services[@]}")
    # This bridge has meaning only for the SurgiMate UI-journal lane in Live
    # and Replay. Always remove the prior process across a full runtime
    # convergence, then start it again below only for the active supported
    # mode.
    runtime_reset_services+=(rosbag-ui-audit-bridge)
    if [[ "${BUILD_REQUESTED}" != "true" ]]; then
      # A non-build mode switch replaces only mutually-exclusive runtime
      # cores.  Independent ASR/UI/bridge/model owners remain alive unless
      # their own Compose contract changes; a scoped ROS build above retains
      # the wider reader stop because it mutates the shared install overlay.
      runtime_reset_services=(
        "${split_owner_services[@]}"
        shadow-runner
        # This socket only owns current Live camera topics. Never carry it
        # into a different runtime mode merely because it is independent of
        # the state/control owner graph.
        local-media-rosbridge
        rosbag-ui-audit-bridge
      )
      if [[ "${mode}" != "live" ]]; then
        runtime_reset_services+=(taskplanner-asr)
      fi
    fi
    RUNTIME_FAILURE_CLEANUP_SERVICES=()
    verify_mode_replacement_execution_interlock
    RUNTIME_FAILURE_CLEANUP_ARMED=true
    # Cold starts and explicit builds replace the relevant runtime plane. The
    # same-mode core-only path returned above and never reaches this cleanup.
    clear_active_runtime_mode
    taskplanner_compose_stop_remove "${runtime_reset_services[@]}"

    taskplanner_build_selected_runtime "${mode}"

    # Releases before the Compose control plane used a host transient service.
    # Stop only that legacy process so it cannot occupy the manager port.
    run_or_print stop_legacy_ninfer_manager

    runtime_service="taskplanner-state-core"
    if [[ "${mode}" == "replay" ]]; then
      runtime_service="shadow-runner"
    fi
    if [[ "${TASKPLANNER_START_LMSTUDIO_CONTROL_PLANE:-false}" == "true" ]]; then
      run_best_effort \
        "LM Studio control plane is unavailable; provider remains offline" \
        start_lmstudio_control_plane "${mode}" "${runtime_service}"
    fi
    if [[ "${TASKPLANNER_START_UNSLOTH_CONTROL_PLANE:-false}" == "true" ]]; then
      run_best_effort \
        "Unsloth Studio control plane is unavailable; provider remains offline" \
        start_unsloth_control_plane "${mode}" "${runtime_service}"
    fi

    runtime_profile_args=(--profile "${mode}")
    if [[ "${mode}" == "live" || "${mode}" == "llm-surgeon" ]]; then
      runtime_profile_args+=(--profile owners)
    fi
    if [[ "${INTEGRATED_DEBUG_ENABLED}" == "true" ]]; then
      runtime_profile_args+=(--profile debug)
    fi
    refresh_webapp_if_stale "${runtime_profile_args[@]}"
    # Browser and NInfer lifecycle are independent owner lanes. Start both
    # without a health/model barrier so a cold core can become observable and
    # deterministic commands can be used while a large VLM is still loading.
    run_or_print \
      "${COMPOSE[@]}" "${runtime_profile_args[@]}" \
      up -d "${BUILD_ARGS[@]}" webapp
    run_best_effort \
      "NInfer manager did not start; VLM-backed requests remain unavailable while other owners continue" \
      "${COMPOSE[@]}" --profile "${mode}" \
      up -d "${BUILD_ARGS[@]}" ninfer-manager
    if [[ "${TASKPLANNER_NINFER_AUTOLOAD_ON_COLD_START:-false}" == "true" ]]; then
      run_best_effort \
        "NInfer model autoload did not start; load it explicitly from the provider control" \
        ensure_ninfer_model_loaded
    fi

    if mode_uses_multicam_observer "${mode}"; then
      run_best_effort \
        "multicam observer did not start; core runtime remains available" \
        "${COMPOSE[@]}" --profile "${mode}" \
        up -d "${BUILD_ARGS[@]}" "${multicam_recreate_args[@]}" \
        multicam-observer
      track_runtime_failure_cleanup_if_reset \
        multicam-observer "${runtime_reset_services[@]}"
    fi

    if mode_uses_tts_sidecar "${mode}"; then
      # Start model prewarm beside the independent command owners. This does
      # not wait for health and emits no audio until a sent execution fact or
      # valid VLM reply reaches the TTS observer.
      ensure_live_tts_sidecar "${mode}" \
        "${BUILD_ARGS[@]}" "${tts_recreate_args[@]}"
    fi

    if mode_uses_operational_asr_sidecar "${mode}"; then
      # ASR capture has its own status/restart control. Do not hold the entire
      # owner set behind its USB/remote-route health; an unavailable microphone
      # is shown by the ASR owner and can be restarted independently.
      run_best_effort \
        "Live ASR owner did not start; voice input remains independently unavailable" \
        "${COMPOSE[@]}" --profile "${mode}" \
        up -d "${BUILD_ARGS[@]}" "${asr_recreate_args[@]}" \
        taskplanner-asr
      track_runtime_failure_cleanup_if_reset \
        taskplanner-asr "${runtime_reset_services[@]}"
      # Live is voice-operated by default.  Starting only the sidecar leaves
      # the node STOPPED with no typed utterance publisher and makes every
      # integration start wait forever.  Start the reviewed auto route after
      # the control service is healthy; operators can explicitly opt out for a
      # microphone-free diagnostic launch.
      if [[ "${TASKPLANNER_LIVE_ASR_AUTO_START:-true}" == "true" ]]; then
        run_best_effort \
          "Live ASR capture did not start; use the ASR control to retry without restarting Taskplanner" \
          start_operational_asr_capture
      fi
    fi

    if [[ "${local_object_perception_enabled}" == "true" ]]; then
      # RF-DETR is optional and has an independent health contract. Start its
      # warm-up before the ROS runtime so GPU/model initialization overlaps the
      # bridge launch instead of adding serial mode-switch latency.
      run_best_effort \
        "optional object perception did not start; continuing with ROS and voice inputs" \
        "${COMPOSE[@]}" --profile "${mode}" \
        up -d "${BUILD_ARGS[@]}" object-perception
      track_runtime_failure_cleanup_if_reset \
        object-perception "${runtime_reset_services[@]}"
    fi
    if [[ "${local_pnu_perception_enabled}" == "true" ]]; then
      # Start model loading before the ROS adapter so the latest-only input
      # queue cannot accumulate camera frames during CUDA warm-up.
      run_best_effort \
        "optional PNU perception did not start; ROS health will remain degraded" \
        "${COMPOSE[@]}" --profile "${mode}" \
        up -d "${BUILD_ARGS[@]}" pnu-perception
      track_runtime_failure_cleanup_if_reset \
        pnu-perception "${runtime_reset_services[@]}"
    fi

    if [[ "${mode}" == "replay" ]]; then
      run_or_print \
        "${COMPOSE[@]}" --profile replay \
        up -d "${BUILD_ARGS[@]}" shadow-runner
    else
      mapfile -t runtime_owner_services < <(
        taskplanner_owner_services_for_mode "${mode}"
      )
      ((${#runtime_owner_services[@]} > 0)) ||
        die "runtime owner registry returned no ${mode} services"
      runtime_nonperception_owner_services=()
      runtime_perception_owner_services=()
      for owner_service in "${runtime_owner_services[@]}"; do
        if [[ "${owner_service}" == "taskplanner-perception" ]]; then
          runtime_perception_owner_services+=("${owner_service}")
        else
          runtime_nonperception_owner_services+=("${owner_service}")
        fi
      done
      run_or_print \
        "${COMPOSE[@]}" --profile "${mode}" --profile owners \
        up -d "${BUILD_ARGS[@]}" "${runtime_nonperception_owner_services[@]}"
      if ((${#runtime_perception_owner_services[@]} > 0)); then
        # VLM/camera/PNU configuration belongs to this owner. A bad optional
        # perception process must not roll back or prevent deterministic core
        # owners from starting; its scoped status/restart surface reports it.
        run_best_effort \
          "perception owner did not start; inspect/restart only the perception owner" \
          "${COMPOSE[@]}" --profile "${mode}" --profile owners \
          up -d "${BUILD_ARGS[@]}" "${runtime_perception_owner_services[@]}"
      fi
    fi
    if [[ "${mode}" == "replay" ]]; then
      track_runtime_failure_cleanup_if_reset \
        "${runtime_service}" "${runtime_reset_services[@]}"
    else
      for owner_service in "${runtime_owner_services[@]}"; do
        track_runtime_failure_cleanup_if_reset \
          "${owner_service}" "${runtime_reset_services[@]}"
      done
    fi

    ensure_surgimate_sidecar "${mode}"

    if [[ "${public_rosbridge_enabled}" == "true" ]]; then
      # Keep browser serialization and image backpressure outside the planner
      # process. A bridge OOM is contained by its 512 MiB cgroup and restart
      # policy instead of taking the operational runtime down with it.
      run_best_effort \
        "public rosbridge did not start; the operator bridge owner remains independently available" \
        "${COMPOSE[@]}" --profile "${mode}" \
        up -d "${public_rosbridge_recreate_args[@]}" public-rosbridge
      track_runtime_failure_cleanup_if_reset \
        public-rosbridge "${runtime_reset_services[@]}"
      # Keep the public browser surface separate from the operator/debug LAN
      # proxy. This route exposes only the read-only 9092 sidecar on the wired
      # interface and is available in Live, LLM Surgeon, and Replay.
      if mode_uses_ops_plane "${mode}"; then
        run_or_print \
          "${COMPOSE[@]}" --profile ops \
          up -d public-rosbridge-lan-proxy
        track_runtime_failure_cleanup_if_reset \
          public-rosbridge-lan-proxy "${runtime_reset_services[@]}"
      fi
    fi

    if [[ "${local_media_rosbridge_enabled}" == "true" ]]; then
      # Keep high-rate compressed frames outside the generic operator bridge.
      # This sidecar is loopback-only and has no public/LAN proxy route, so a
      # camera-side restart cannot affect commands, state, ASR, or the VLM.
      run_best_effort \
        "local media rosbridge did not start; the operator bridge remains independently available" \
        "${COMPOSE[@]}" --profile "${mode}" \
        up -d "${local_media_rosbridge_recreate_args[@]}" local-media-rosbridge
      track_runtime_failure_cleanup_if_reset \
        local-media-rosbridge "${runtime_reset_services[@]}"
    fi

    if [[ "${rosbag_ui_audit_bridge_enabled}" == "true" ]]; then
      # The SurgiMate browser keeps its public clinical subscription surface
      # read-only. This tiny local lane accepts only bounded presentation
      # journal events, so it cannot issue services, Actions, or planner
      # controls while a manual MCAP recording is active.
      run_best_effort \
        "rosbag UI audit bridge did not start; SurgiMate clinical projection remains independently available" \
        "${COMPOSE[@]}" --profile "${mode}" \
        up -d "${rosbag_ui_audit_bridge_recreate_args[@]}" rosbag-ui-audit-bridge
      track_runtime_failure_cleanup_if_reset \
        rosbag-ui-audit-bridge "${runtime_reset_services[@]}"
    fi

    if mode_uses_ops_plane "${mode}"; then
      # LAN/Tailnet exposure is an explicit Ops plane. The loopback Production
      # core neither starts nor waits for these services.
      run_or_print \
        "${COMPOSE[@]}" --profile ops \
        up -d webapp-lan-proxy \
        integration-debug-lan-proxy integration-debug-tailscale-proxy
      track_runtime_failure_cleanup_if_reset \
        webapp-lan-proxy "${runtime_reset_services[@]}"
      track_runtime_failure_cleanup_if_reset \
        integration-debug-lan-proxy "${runtime_reset_services[@]}"
      track_runtime_failure_cleanup_if_reset \
        integration-debug-tailscale-proxy "${runtime_reset_services[@]}"
    elif [[ "${mode}" != "live" ]]; then
      # Legacy Lab/Debug modes retain their path router until they are split
      # into a separate launcher. This branch is never part of Production.
      run_or_print \
        "${COMPOSE[@]}" --profile "${mode}" \
        up -d integration-debug-lan-proxy integration-debug-tailscale-proxy
      track_runtime_failure_cleanup_if_reset \
        integration-debug-lan-proxy "${runtime_reset_services[@]}"
      track_runtime_failure_cleanup_if_reset \
        integration-debug-tailscale-proxy "${runtime_reset_services[@]}"
    fi

    taskplanner_finalize_runtime_readiness \
      "${mode}" "${INTEGRATED_DEBUG_ENABLED}" "${runtime_profile_args[@]}"
    ;;

  resume)
    resume_mode="live"
    if (($#)) && [[ "$1" != --* ]]; then
      resume_mode="$1"
      shift
    fi
    case "${resume_mode}" in
      live|llm-surgeon|replay) ;;
      *) die "resume mode must be live, llm-surgeon, or replay" ;;
    esac
    while (($#)); do
      case "$1" in
        --dry-run) DRY_RUN=true ;;
        -h|--help)
          usage
          exit 0
          ;;
        *) die "unknown resume option: $1" ;;
      esac
      shift
    done
    enforce_runtime_mode_contract "${resume_mode}"
    acquire_launcher_lock
    compose_env_args "${resume_mode}"
    taskplanner_compose_init
    printf 'Taskplanner %s: resuming stopped core only (preserving sidecars)\n' \
      "${resume_mode}"
    taskplanner_resume_stopped_core "${resume_mode}"
    ensure_live_tts_sidecar "${resume_mode}"
    ;;

  restart)
    restart_target="${1:-}"
    [[ -n "${restart_target}" ]] ||
      die "restart requires one runtime owner; run 'scripts/taskplanner owners' to list them"
    shift
    restart_mode="live"
    if (($#)) && [[ "$1" != --* ]]; then
      restart_mode="$1"
      shift
    fi
    while (($#)); do
      case "$1" in
        --dry-run) DRY_RUN=true ;;
        --require-active-live)
          [[ "${restart_target}" == "asr" ]] ||
            die "--require-active-live is valid only for restart asr"
          ASR_RESTART_REQUIRE_ACTIVE_LIVE=true
          ;;
        --ensure-build)
          ENSURE_BUILD=true
          ;;
        -h|--help)
          usage
          exit 0
          ;;
        *) die "unknown restart option: $1" ;;
      esac
      shift
    done
    if [[ "${restart_target}" == "asr" ]]; then
      restart_mode="live"
    fi
    validate_mode "${restart_mode}"
    enforce_runtime_mode_contract "${restart_mode}"
    compose_env_args "${restart_mode}"
    taskplanner_owner_resolve "${restart_target}" "${restart_mode}" ||
      die "could not resolve runtime owner: ${restart_target}"
    restart_target="${TASKPLANNER_OWNER_NAME}"
    [[ "${TASKPLANNER_OWNER_MODE_SUPPORTED}" == "true" ]] ||
      die "owner ${restart_target} is not available in ${restart_mode} mode"
    [[ "${TASKPLANNER_OWNER_ENABLED}" == "true" ]] ||
      die "owner ${restart_target} is disabled by its configured capability selection"
    acquire_launcher_lock
    taskplanner_compose_init
    case "${TASKPLANNER_OWNER_RESTART_STRATEGY}" in
      core)
        trap cleanup_failed_runtime_start EXIT
        runtime_service="$(taskplanner_runtime_service_for_mode "${restart_mode}")" ||
          die "could not resolve the ${restart_mode} core service"
        if [[ "${ENSURE_BUILD}" == "true" ]]; then
          taskplanner_build_owner_if_needed "${restart_mode}" "${restart_target}"
        fi
        printf 'Taskplanner %s: restarting %s only\n' "${restart_mode}" "${restart_target}"
        taskplanner_cross_warm_restart_boundary "${restart_mode}" "${runtime_service}"
        write_active_runtime_mode "${restart_mode}"
        RUNTIME_FAILURE_CLEANUP_ARMED=false
        ;;
      asr)
        printf 'Taskplanner Live: restarting ASR only\n'
        if [[ "${ASR_RESTART_REQUIRE_ACTIVE_LIVE}" == "true" ]] &&
            ! taskplanner_same_mode_core_running live; then
          die "ASR restart requires the active Live core; use 'resume live' after reboot"
        fi
        if [[ "${ENSURE_BUILD}" == "true" ]]; then
          taskplanner_build_owner_if_needed live "${restart_target}"
        fi
        # ASR is a Live-profile sidecar, not a split `owners` core service.
        warm_restart_runtime_service live taskplanner-asr live
        if [[ "${TASKPLANNER_LIVE_ASR_AUTO_START:-true}" == "true" ]]; then
          start_operational_asr_capture
        fi
        ;;
      sidecar)
        printf 'Taskplanner %s: restarting %s sidecar only\n' \
          "${restart_mode}" "${restart_target}"
        if [[ "${restart_target}" == "tts" ]]; then
          # Own the writable cache paths before Compose can create them as
          # root. A failed local audio preflight remains owner-local.
          TTS_RUNTIME_PREFLIGHT_DONE=false
          if ! prepare_tts_runtime; then
            printf 'warning: TTS preflight is unavailable; restarting the independent owner for diagnostics\n' >&2
          fi
        fi
        taskplanner_restart_sidecar_owner \
          "${restart_mode}" "${restart_target}" "${ENSURE_BUILD}"
        ;;
      dedicated)
        printf 'Taskplanner %s: restarting %s owner only\n' \
          "${restart_mode}" "${restart_target}"
        if [[ "${restart_target}" == "rosbag-recorder" ]]; then
          prepare_rosbag_recording_state
        fi
        taskplanner_restart_dedicated_owner \
          "${restart_mode}" "${restart_target}" "${ENSURE_BUILD}"
        ;;
      *)
        die "owner ${restart_target} has an unknown restart strategy"
        ;;
    esac
    ;;

  surgimate)
    surgimate_action="${1:-}"
    case "${surgimate_action}" in
      start|stop|restart) ;;
      *) die "surgimate requires one action: start, stop, or restart" ;;
    esac
    shift
    surgimate_mode="debug"
    while (($#)); do
      case "$1" in
        --mode)
          (($# >= 2)) || die "--mode requires debug"
          surgimate_mode="$2"
          shift
          ;;
        --mode=*) surgimate_mode="${1#*=}" ;;
        --dry-run) DRY_RUN=true ;;
        -h|--help)
          usage
          exit 0
          ;;
        *) die "unknown surgimate option: $1" ;;
      esac
      shift
    done
    [[ "${surgimate_mode}" == "debug" ]] ||
      die "surgimate lifecycle is available only in debug mode"
    enforce_runtime_mode_contract "${surgimate_mode}"
    compose_env_args "${surgimate_mode}"
    taskplanner_owner_resolve surgimate "${surgimate_mode}" ||
      die "could not resolve the surgimate runtime owner"
    [[ "${TASKPLANNER_OWNER_NAME}" == "surgimate" &&
       "${TASKPLANNER_OWNER_RESTART_STRATEGY}" == "sidecar" ]] ||
      die "surgimate is not a sidecar runtime owner"
    acquire_launcher_lock
    taskplanner_compose_init
    case "${surgimate_action}" in
      start)
        printf 'Taskplanner Debug: starting surgimate sidecar only\n'
        taskplanner_start_sidecar_owner "${surgimate_mode}" surgimate
        ;;
      stop)
        printf 'Taskplanner Debug: stopping surgimate sidecar only\n'
        taskplanner_stop_sidecar_owner "${surgimate_mode}" surgimate
        ;;
      restart)
        printf 'Taskplanner Debug: restarting surgimate sidecar only\n'
        taskplanner_restart_sidecar_owner "${surgimate_mode}" surgimate false
        ;;
    esac
    ;;

  reload)
    reload_target="${1:-}"
    [[ "${reload_target}" == "config" ]] ||
      die "reload currently supports only: reload config <bundle>"
    shift
    reload_bundle="${1:-}"
    [[ -n "${reload_bundle}" ]] ||
      die "reload config requires a bundle name"
    shift
    reload_mode="live"
    while (($#)); do
      case "$1" in
        --mode)
          (($# >= 2)) || die "--mode requires live or llm-surgeon"
          reload_mode="$2"
          shift
          ;;
        --mode=*) reload_mode="${1#*=}" ;;
        --dry-run) DRY_RUN=true ;;
        -h|--help)
          usage
          exit 0
          ;;
        *) die "unknown reload option: $1" ;;
      esac
      shift
    done
    case "${reload_mode}" in
      live|llm-surgeon) ;;
      *) die "reload config mode must be live or llm-surgeon" ;;
    esac
    enforce_runtime_mode_contract "${reload_mode}"
    acquire_launcher_lock
    compose_env_args "${reload_mode}"
    taskplanner_compose_init
    printf 'Taskplanner %s: reloading configuration for %s (no build or restart)\n' \
      "${reload_mode}" "${reload_bundle}"
    taskplanner_reload_runtime_config "${reload_mode}" "${reload_bundle}"
    ;;

  down)
    while (($#)); do
      case "$1" in
        --dry-run) DRY_RUN=true ;;
        -h|--help)
          usage
          exit 0
          ;;
        *) die "unknown down option: $1" ;;
      esac
      shift
    done
    acquire_launcher_lock
    # A runtime-control initiated clean cycle carries this one final
    # active-request check into the destructive half of the sequence. Direct
    # shell `down` remains researcher-controlled and does not gain a broad
    # readiness dependency.
    verify_runtime_control_transition_interlock
    compose_env_args
    taskplanner_compose_init
    run_or_print \
      "${COMPOSE[@]}" "${ALL_PROFILE_ARGS[@]}" \
      down --remove-orphans
    clear_active_runtime_mode
    # A dashboard-requested clean restart is supervised by the existing
    # loopback runtime-control process.  Do not tear that process down halfway
    # through its own `down` → `up` sequence; an ordinary terminal `down`
    # still stops it exactly as before.
    if [[ "${TASKPLANNER_RUNTIME_CONTROL_CHILD:-}" != "1" ]]; then
      stop_runtime_control_service
    fi
    stop_legacy_ninfer_manager
    stop_lmstudio_control_plane
    stop_unsloth_control_plane
    ;;

  status)
    if (($#)); then
      status_target="$1"
      shift
      [[ "${status_target}" == "owners" ]] && status_target="all"
      status_mode="live"
      while (($#)); do
        case "$1" in
          --mode)
            (($# >= 2)) || die "--mode requires live, llm-surgeon, replay, or debug"
            status_mode="$2"
            shift
            ;;
          --mode=*) status_mode="${1#*=}" ;;
          -h|--help)
            usage
            exit 0
            ;;
          *) die "unknown owner-status option: $1" ;;
        esac
        shift
      done
      case "${status_mode}" in
        live|llm-surgeon|replay|debug) ;;
        *) die "owner status mode must be live, llm-surgeon, replay, or debug" ;;
      esac
      compose_env_args "${status_mode}"
      if [[ "${status_target}" != "all" ]]; then
        taskplanner_owner_exists "${status_target}" "${status_mode}" ||
          die "unknown runtime owner: ${status_target}"
      fi
      taskplanner_owner_status "${status_target}" "${status_mode}"
      exit 0
    fi
    compose_env_args
    taskplanner_compose_init
    "${COMPOSE[@]}" "${ALL_PROFILE_ARGS[@]}" ps -a
    if ninfer_manager_ready "$(ninfer_manager_url)"; then
      printf 'NInfer manager: Compose control plane ready\n'
    else
      printf 'NInfer manager: unavailable\n'
    fi
    if command -v lms >/dev/null 2>&1 &&
        lms server status 2>&1 | grep -q '^The server is running'; then
      printf 'LM Studio catalog server: active\n'
    else
      printf 'LM Studio catalog server: stopped\n'
    fi
    if user_systemd_available &&
        systemctl --user is-active --quiet "${UNSLOTH_CONTROL_UNIT}"; then
      printf 'Unsloth Studio catalog server: active transient user service\n'
    else
      printf 'Unsloth Studio catalog server: external or stopped\n'
    fi
    ;;

  owners)
    (($# == 0)) || die "owners takes no arguments"
    taskplanner_owner_list
    ;;

  runtime-control)
    while (($#)); do
      case "$1" in
        --dry-run) DRY_RUN=true ;;
        -h|--help)
          usage
          exit 0
          ;;
        *) die "unknown runtime-control option: $1" ;;
      esac
      shift
    done
    acquire_launcher_lock
    ensure_runtime_control_service
    if [[ "${DRY_RUN}" != "true" ]]; then
      printf 'Taskplanner runtime-control: ready on 127.0.0.1:%s\n' "${RUNTIME_CONTROL_PORT}"
    fi
    ;;

  config)
    mode="${1:-}"
    validate_mode "${mode}"
    (($# == 1)) || die "config takes exactly one mode"
    enforce_runtime_mode_contract "${mode}"
    compose_env_args "${mode}"
    if mode_requires_integrated_debug_observer "${mode}"; then
      export TASKPLANNER_DEBUG_LOCK_TO_RUNTIME_NETWORK=true
      export TASKPLANNER_DEBUG_ALLOW_PLANNER_COEXISTENCE=false
    fi
    taskplanner_compose_init
    config_profile_args=(--profile "${mode}")
    if [[ "${mode}" == "live" || "${mode}" == "llm-surgeon" || "${mode}" == "debug" ]]; then
      config_profile_args+=(--profile owners)
    fi
    if mode_requires_integrated_debug_observer "${mode}"; then
      config_profile_args+=(--profile debug)
    fi
    "${COMPOSE[@]}" "${config_profile_args[@]}" config
    ;;

  verify-release)
    exec python3 "${ROOT_DIR}/scripts/verify_release.py" "$@"
    ;;

  *)
    die "unknown command: ${action}"
    ;;
esac
