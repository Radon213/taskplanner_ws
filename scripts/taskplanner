#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
COMPOSE_FILE="${ROOT_DIR}/docker-compose.yml"
source "${ROOT_DIR}/scripts/lib/taskplanner_mode_policy.sh"
source "${ROOT_DIR}/scripts/lib/taskplanner_execution.sh"
source "${ROOT_DIR}/scripts/lib/taskplanner_owner_control.sh"
CONTAINER_INSTALL_REL="install/docker"
CONTAINER_INSTALL_ABS="/workspaces/taskplanner_ws/${CONTAINER_INSTALL_REL}"
CONTAINER_INSTALL_ROOT="${ROOT_DIR}/${CONTAINER_INSTALL_REL}"
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}/taskplanner"
NINFER_MANAGER_PID_FILE="${RUNTIME_DIR}/ninfer-manager.pid"
NINFER_MANAGER_UNIT="taskplanner-ninfer-manager.service"
LMSTUDIO_STARTED_FILE="${RUNTIME_DIR}/lmstudio.started"
LMSTUDIO_CONTROL_UNIT="taskplanner-lmstudio-control.scope"
UNSLOTH_CONTROL_UNIT="taskplanner-unsloth-control.service"
RUNTIME_CONTROL_UNIT="taskplanner-runtime-control.service"
RUNTIME_CONTROL_PORT="${TASKPLANNER_RUNTIME_CONTROL_PORT:-8150}"
RUNTIME_CONTROL_TRANSITION_TIMEOUT_SEC="${TASKPLANNER_RUNTIME_TRANSITION_TIMEOUT_SEC:-420}"
RUNTIME_CONTROL_TOKEN_FILE="${TASKPLANNER_RUNTIME_CONTROL_TOKEN_FILE:-${HOME}/.config/taskplanner/secrets/runtime-control-token}"
RUNTIME_CONTROL_STATE_FILE="${RUNTIME_DIR}/active-runtime-mode.json"
RUNTIME_CONTROL_PID_FILE="${RUNTIME_DIR}/runtime-control.pid"
RUNTIME_CONTROL_LOG_FILE="${RUNTIME_DIR}/runtime-control.log"
RUNTIME_CONTROL_LAUNCH_LOG_FILE="${RUNTIME_DIR}/runtime-control-launch.log"
export TASKPLANNER_RUNTIME_CONTROL_TOKEN_FILE="${RUNTIME_CONTROL_TOKEN_FILE}"
RUNTIME_FAILURE_CLEANUP_ARMED=false
RUNTIME_FAILURE_CLEANUP_SERVICES=()
TTS_RUNTIME_PREFLIGHT_DONE=false

usage() {
  cat <<'EOF'
Taskplanner deployment launcher

Usage:
  scripts/taskplanner up [live|llm-surgeon|replay|debug] [--dry-run] [--ros-build|--image-build|--build|--ensure-build] [--replace-active]
  scripts/taskplanner resume [live|llm-surgeon|replay] [--dry-run]
  scripts/taskplanner restart <owner> [live|llm-surgeon|replay|debug] [--dry-run] [--ensure-build]
  scripts/taskplanner surgimate <start|stop|restart> [--mode debug] [--dry-run]
  scripts/taskplanner reload config <bundle> [--mode live|llm-surgeon] [--dry-run]
  scripts/taskplanner ui <dev|apply|status> [--mode live|llm-surgeon|replay|debug] [--dry-run]
  scripts/taskplanner down [--dry-run]
  scripts/taskplanner status [owners|<owner>] [--mode live|llm-surgeon|replay]
  scripts/taskplanner owners
  scripts/taskplanner runtime-control [--dry-run]
  scripts/taskplanner config <live|llm-surgeon|replay|debug>
  scripts/taskplanner verify-release [--tier quick|rc|full]
  scripts/taskplanner help

Commands:
  up       Start the selected runtime plus the core web/ROS interfaces. Live
           uses one NInfer provider and consumes typed RF-DETR observations
           from 192.168.1.7; it never starts a local detector or PNU worker.
           Alternative model/perception stacks are Lab-only.
           Debug starts the independently restartable observer and
           paused/stopped control owners plus its virtual endpoint owner by
           default. Set TASKPLANNER_DEBUG_ENABLE_VIRTUAL_ROBOT=false to omit
           that endpoint owner. It never starts ASR, recording, PNU, VLM, or
           network-settings sidecars. Live starts its USB
           microphone ASR sidecar and the local TTS owner. Multicam and
           LAN/Tailnet proxies remain optional Ops services. TTS model
           readiness is reported by its owner and never blocks Action/Service
           command admission.
           Omitting a runtime selects Live, the actual external-integration
           profile. LLM Surgeon and Replay do not start the Ops plane by
           default. Manual Debug
           control unlocks only while the operational scenario reports a
           trusted, fresh paused or fully stopped state with idle resources.
           --replace-active permits an explicit reviewed transition from an
           operational runtime into standalone Debug Mode.
           Reuses the container-only install/docker overlay and node_modules
           unless an explicit image build is supplied. Host and release builds keep install/.
           --ensure-build validates the selected runtime's install contract
           first and performs the scoped serialized ROS build only when stale.
           A same-mode operational runtime restarts only its core and preserves
           the stable model, ASR, browser, and ROS bridge sidecars.
  restart  Restart one already-running owner without touching unrelated
           services. Canonical owners are state-core, command, tool-state,
           perception, cam4-mayo, projection, execution, operator-bridge,
           scenario, simulation-input, asr, tts, surgery-record, rosbag-recorder, debug-observer, debug-control,
           debug-virtual, and surgimate. `core`
           and `bridge` are temporary CLI aliases. --ensure-build builds only that owner's stale package
           closure before its restart. A split owner must already be deployed;
           this command never creates a missing owner as a side effect.
  reload config
           Apply one scenario bundle through its running scenario owner. This
           never rebuilds or restarts the Taskplanner runtime.
  ui       Run the dashboard-only development loop. `ui dev` replaces only
           webapp with Vite HMR on 127.0.0.1:4173; `ui apply` builds and stamps
           only the browser bundle; `ui status` is read-only. None restarts
           ROS, ASR, VLM, NInfer, rosbridge, or another runtime owner.
  resume   Recover a stopped runtime after reboot without touching preserved
           webapp, rosbridge, or other sidecars. It starts only the selected
           core, NInfer manager, Live ASR capture, and the Live TTS owner when
           configured.
  surgimate
           Start, stop, or restart only the isolated SurgiMate static server
           for standalone Debug. It never starts ROS, a bridge, or another
           runtime owner; Live startup already starts the sidecar automatically.
  down     Stop and remove every Taskplanner Compose profile.
  status   With no argument, show every Taskplanner container. With `owners`
           or an owner name, project the lightweight owner registry and its
           current embedded/dedicated state.
  owners   List the runtime-owner registry without querying or changing ROS.
  runtime-control
           Start or verify the loopback-only, token-gated service used by the
           dashboard to switch among reviewed runtime modes.
  config   Render the fully resolved Compose configuration for one mode.
  verify-release
           Run reproducible software release gates and write JSON/CSV/Markdown/SVG reports.

Environment:
  .env.example is always loaded first. A local .env overrides deployment
  paths and credentials. Mode-owned values are loaded last; exported shell
  variables have highest precedence.

Examples:
  cp .env.example .env
  scripts/taskplanner up              # Live external integration (default)
  scripts/taskplanner up live
  scripts/taskplanner up live --ros-build
  scripts/taskplanner up live --image-build
  scripts/taskplanner resume live
  scripts/taskplanner restart state-core live
  scripts/taskplanner restart command live --dry-run
  scripts/taskplanner restart scenario live
  scripts/taskplanner restart asr
  scripts/taskplanner surgimate restart --mode debug
  scripts/taskplanner status owners --mode live
  scripts/taskplanner reload config thyroidectomy_demo
  scripts/taskplanner ui dev
  scripts/taskplanner ui apply
  scripts/taskplanner ui status
  scripts/taskplanner up replay --dry-run
  scripts/taskplanner up debug --build
  SHADOW_CASE_ID=0704_12 scripts/taskplanner up replay
  scripts/taskplanner down
  scripts/taskplanner verify-release --tier rc
EOF
}

die() {
  printf 'error: %s\n' "$*" >&2
  exit 2
}

validate_mode() {
  taskplanner_mode_is_valid "${1:-}" ||
    die "mode must be live, llm-surgeon, replay, or debug"
}

compose_env_args() {
  local mode="${1:-}"
  ENV_FILES=("${ROOT_DIR}/.env.example")
  ENV_ARGS=(--env-file "${ROOT_DIR}/.env.example")
  if [[ -f "${ROOT_DIR}/.env" ]]; then
    ENV_FILES+=("${ROOT_DIR}/.env")
    ENV_ARGS+=(--env-file "${ROOT_DIR}/.env")
  fi
  if [[ -n "${mode}" ]]; then
    ENV_FILES+=("${ROOT_DIR}/docker/orchestration/${mode}.env")
    ENV_ARGS+=(--env-file "${ROOT_DIR}/docker/orchestration/${mode}.env")
  fi
}

print_command() {
  # Keep a dry-run visually distinct from `set -x` or an executed shell
  # command.  Researchers frequently use this output while a Live graph is
  # already running; a plan must never look like an operation log.
  if [[ "${DRY_RUN:-false}" == "true" ]]; then
    printf 'DRY-RUN +'
  else
    printf '+'
  fi
  printf ' %q' "$@"
  printf '\n'
}

run_or_print() {
  if [[ "${DRY_RUN}" == "true" ]]; then
    print_command "$@"
  else
    "$@"
  fi
}

run_best_effort() {
  local warning_message="$1"
  shift
  if [[ "${DRY_RUN}" == "true" ]]; then
    print_command "$@"
    return 0
  fi
  if ! "$@"; then
    printf 'warning: %s\n' "${warning_message}" >&2
  fi
}

cleanup_failed_runtime_start() {
  local exit_code=$?
  trap - EXIT
  if [[ "${RUNTIME_FAILURE_CLEANUP_ARMED}" == "true" && "${DRY_RUN}" != "true" ]]; then
    printf 'warning: runtime startup failed; removing only services started by this attempt\n' >&2
    set +e
    if ((${#RUNTIME_FAILURE_CLEANUP_SERVICES[@]} > 0)); then
      "${COMPOSE[@]}" "${ALL_PROFILE_ARGS[@]}" \
        stop "${RUNTIME_FAILURE_CLEANUP_SERVICES[@]}"
      "${COMPOSE[@]}" "${ALL_PROFILE_ARGS[@]}" \
        rm -f "${RUNTIME_FAILURE_CLEANUP_SERVICES[@]}"
    fi
    clear_active_runtime_mode
    set -e
  fi
  exit "${exit_code}"
}

track_runtime_failure_cleanup_service() {
  local service existing
  for service in "$@"; do
    for existing in "${RUNTIME_FAILURE_CLEANUP_SERVICES[@]}"; do
      [[ "${existing}" == "${service}" ]] && continue 2
    done
    RUNTIME_FAILURE_CLEANUP_SERVICES+=("${service}")
  done
}

track_runtime_failure_cleanup_if_reset() {
  local service="$1"
  shift
  local reset_service
  for reset_service in "$@"; do
    if [[ "${reset_service}" == "${service}" ]]; then
      track_runtime_failure_cleanup_service "${service}"
      return 0
    fi
  done
}

acquire_launcher_lock() {
  if [[ "${DRY_RUN}" == "true" ]]; then
    return 0
  fi
  command -v flock >/dev/null 2>&1 || die "flock is required for safe launcher serialization"
  mkdir -p "${RUNTIME_DIR}"
  exec {LAUNCHER_LOCK_FD}>"${RUNTIME_DIR}/launcher.lock"
  flock -w "${TASKPLANNER_LAUNCH_LOCK_SEC:-30}" "${LAUNCHER_LOCK_FD}" ||
    die "another Taskplanner start/stop operation is still in progress"
}

verify_expected_runtime_transition_interlock() {
  local expected_mode="${1:-}"
  local failure_message="$2"
  if [[ "${DRY_RUN}" == "true" ]]; then
    print_command verify-runtime-transition-interlock "${expected_mode:-none}"
    return 0
  fi
  if ! python3 - "${ROOT_DIR}" "${RUNTIME_CONTROL_STATE_FILE}" "${expected_mode}" <<'PY'
import importlib.util
import sys
from pathlib import Path

root = Path(sys.argv[1]).resolve()
state_file = Path(sys.argv[2])
expected_mode = sys.argv[3] or None
module_path = root / "scripts" / "taskplanner_runtime_control.py"
spec = importlib.util.spec_from_file_location("taskplanner_runtime_control_gate", module_path)
if spec is None or spec.loader is None:
    raise SystemExit("cannot load the runtime transition safety gate")
module = importlib.util.module_from_spec(spec)
sys.modules[spec.name] = module
spec.loader.exec_module(module)
safe, reason = module.final_transition_interlock_is_safe(
    root,
    state_file,
    expected_mode,
)
if not safe:
    raise SystemExit(reason)
PY
  then
    die "${failure_message}"
  fi
}

verify_same_mode_warm_restart_interlock() {
  # A state-core restart is not a route change and must stay independent from
  # ASR/VLM/camera/DT readiness.  It nevertheless destroys the Twin's
  # in-memory view of a running robot task, so do not cross this boundary when
  # the execution owner positively reports an in-flight Action/Service.
  #
  # A missing or stale execution-route fact is not a broad readiness gate,
  # but it is the one owner-local fact this core restart cannot reconstruct.
  # Do not discard that uncertainty: the execution owner must explicitly
  # report an idle route before its state core is replaced.
  local mode="$1"
  case "${mode}" in
    live|llm-surgeon) ;;
    *) return 0 ;;
  esac
  if [[ "${DRY_RUN}" == "true" ]]; then
    print_command verify-state-core-restart-execution "${mode}"
    return 0
  fi
  if ! python3 - "${ROOT_DIR}" "${mode}" <<'PY'
import importlib.util
import sys
from pathlib import Path

root = Path(sys.argv[1]).resolve()
mode = sys.argv[2]
module_path = root / "scripts" / "taskplanner_runtime_control.py"
spec = importlib.util.spec_from_file_location("taskplanner_state_core_restart_gate", module_path)
if spec is None or spec.loader is None:
    raise SystemExit("cannot load the execution owner interlock")
module = importlib.util.module_from_spec(spec)
sys.modules[spec.name] = module
spec.loader.exec_module(module)
idle = module.execution_owner_is_idle(root, mode)
if idle is not True:
    raise SystemExit("the execution endpoint idle state is unavailable or reports an in-flight request")
PY
  then
    die "state-core warm restart rejected: execution endpoint idle state is unavailable or a request is in flight"
  fi
}

verify_runtime_control_transition_interlock() {
  # Runtime control requests this only immediately before it stops/restarts an
  # owner.  It is deliberately a narrow endpoint check, not a global
  # Digital-Twin or executor readiness receipt.
  if [[ "${TASKPLANNER_RUNTIME_REQUIRE_EXECUTION_IDLE:-0}" != "1" ]]; then
    return 0
  fi
  local expected_mode="${TASKPLANNER_RUNTIME_EXPECTED_ACTIVE_MODE:-}"
  verify_expected_runtime_transition_interlock \
    "${expected_mode}" \
    "an execution endpoint request started during the transition; transition cancelled"
  unset TASKPLANNER_RUNTIME_REQUIRE_EXECUTION_IDLE
  unset TASKPLANNER_RUNTIME_EXPECTED_ACTIVE_MODE
}

verify_mode_replacement_execution_interlock() {
  # A mode replacement may stop the active execution owner.  Unlike a
  # same-mode state-core warm restart, that changes the selected endpoint
  # route, so Live/LLM must fail closed when this one affected owner's activity
  # cannot be observed.  The check intentionally knows nothing about ASR, VLM,
  # camera, Digital-Twin, or unrelated owner readiness.
  if [[ "${TASKPLANNER_RUNTIME_REQUIRE_EXECUTION_IDLE:-0}" == "1" ]]; then
    verify_runtime_control_transition_interlock
    return
  fi
  if [[ "${DRY_RUN}" == "true" ]]; then
    print_command verify-runtime-transition-interlock current-active-mode
    return 0
  fi
  local gate_result
  gate_result="$({
    python3 - "${ROOT_DIR}" "${RUNTIME_CONTROL_STATE_FILE}" <<'PY'
import importlib.util
import sys
from pathlib import Path

root = Path(sys.argv[1]).resolve()
state_file = Path(sys.argv[2])
module_path = root / "scripts" / "taskplanner_runtime_control.py"
spec = importlib.util.spec_from_file_location("taskplanner_terminal_transition_gate", module_path)
if spec is None or spec.loader is None:
    raise SystemExit("cannot load the runtime transition safety gate")
module = importlib.util.module_from_spec(spec)
sys.modules[spec.name] = module
spec.loader.exec_module(module)
expected_mode = module.read_active_mode(state_file)
safe, reason = module.final_transition_interlock_is_safe(
    root,
    state_file,
    expected_mode,
)
if not safe:
    raise SystemExit(reason)
print("allowed")
PY
  } 2>&1)" || die "mode replacement rejected: ${gate_result:-execution endpoint state is unavailable}"
  [[ "${gate_result}" == "allowed" ]] ||
    die "mode replacement rejected: ${gate_result}"
}

verify_runtime_install_contract() {
  local mode="$1"
  # An explicit ROS build selects the mode closure. Ordinary starts and
  # --ensure-build build only packages whose per-package contract is stale;
  # they may adopt a verified installed overlay without a whole-workspace build.
  taskplanner_prepare_mode_build_plan "${mode}" "${FORCE_REBUILD_REQUESTED}" ||
    die "could not compute the ${mode} package build contract"
  if [[ "${FORCE_REBUILD_REQUESTED}" == "true" ]]; then
    return 0
  fi

  # Only changed/missing artifacts need colcon. A missing per-package stamp is
  # a baseline migration candidate, not proof that every package in the mode
  # is stale. The narrow runtime import check below establishes that baseline.
  if ((${#TASKPLANNER_BUILD_PACKAGES[@]} > 0)) || \
      [[ "${TASKPLANNER_MODE_BUILD_MISMATCHED_STAMP}" == "true" ]] || \
      [[ "${TASKPLANNER_MODE_BUILD_MISSING_ARTIFACT}" == "true" ]]; then
    [[ "${BUILD_REQUESTED}" == "true" ]] && return 0
    return 1
  fi

  if ((${#TASKPLANNER_MODE_BUILD_BASELINE_PACKAGES[@]} == 0)); then
    return 0
  fi

  local check_command
  if [[ "${mode}" == "debug" ]]; then
    check_command="source /opt/ros/jazzy/setup.bash && source /opt/btops_ws/install/setup.bash && source ${CONTAINER_INSTALL_ABS}/setup.bash && test -x ${CONTAINER_INSTALL_ABS}/integration_debug/lib/integration_debug/integration_debug_observer && test -x ${CONTAINER_INSTALL_ABS}/integration_debug/lib/integration_debug/integration_debug_control && test -e ${CONTAINER_INSTALL_ABS}/bringup/share/bringup/launch/taskplanner_debug_observer.launch.py && test -e ${CONTAINER_INSTALL_ABS}/bringup/share/bringup/launch/taskplanner_debug_control.launch.py && ros2 pkg prefix integration_debug >/dev/null"
    if taskplanner_owner_is_enabled debug-virtual debug; then
      check_command+=" && test -x ${CONTAINER_INSTALL_ABS}/surgical_interop_execution/lib/surgical_interop_execution/fault_action_emulator && test -e ${CONTAINER_INSTALL_ABS}/bringup/share/bringup/launch/taskplanner_debug_virtual.launch.py"
    fi
  else
    check_command="source /opt/ros/jazzy/setup.bash && source /opt/btops_ws/install/setup.bash && source ${CONTAINER_INSTALL_ABS}/setup.bash && test -x ${CONTAINER_INSTALL_ABS}/voice_command/lib/voice_command/voice_intent_resolver && test -x ${CONTAINER_INSTALL_ABS}/voice_command/lib/voice_command/command_router && ros2 pkg prefix voice_command >/dev/null && python3 -c 'from surgical_msgs.msg import VoiceCommandIntent; import voice_command.node; from bt_orchestrator.bed_robot_arm_group_orchestrator import BedRobotArmGroupOrchestrator; from or_digital_twin.node import ORDigitalTwinNode'"
    if [[ "${mode}" == "live" || "${mode}" == "replay" ]]; then
      check_command+=" && test -x ${CONTAINER_INSTALL_ABS}/integration_debug/lib/integration_debug/operational_surgery_record && test -e ${CONTAINER_INSTALL_ABS}/bringup/share/bringup/launch/taskplanner_surgery_record.launch.py && test -x ${CONTAINER_INSTALL_ABS}/integration_debug/lib/integration_debug/operational_rosbag_recorder && test -e ${CONTAINER_INSTALL_ABS}/bringup/share/bringup/launch/taskplanner_rosbag_recorder.launch.py && test -x ${CONTAINER_INSTALL_ABS}/surgical_interop_gateway/lib/surgical_interop_gateway/rosbag_ui_audit_rosbridge"
    fi
    if mode_uses_tts_sidecar "${mode}"; then
      check_command+=" && test -x ${CONTAINER_INSTALL_ABS}/tts_runtime/lib/tts_runtime/tts_runtime_node && python3 -c 'import tts_runtime.correlation'"
    fi
  fi
  if ! run_or_print \
      "${COMPOSE[@]}" --profile dev run --rm --no-deps -T \
      --user "$(id -u):$(id -g)" \
      -e HOME=/tmp/taskplanner-install-check \
      taskplanner-dev bash -lc "${check_command}"; then
    return 1
  fi
  if [[ "${DRY_RUN}" != "true" ]]; then
    taskplanner_record_mode_package_contracts "${mode}"
  fi
  TASKPLANNER_CHANGED_BUILD_PACKAGES=()
  TASKPLANNER_BUILD_PACKAGES=()
}

ensure_runtime_install_contract() {
  local mode="$1"
  if verify_runtime_install_contract "${mode}"; then
    return 0
  fi
  if [[ "${ENSURE_BUILD}" == "true" ]]; then
    printf 'runtime install is stale or incomplete; rebuilding scoped %s packages: %s\n' \
      "${mode}" "${TASKPLANNER_BUILD_PACKAGES[*]}" >&2
    BUILD_REQUESTED=true
    return 0
  fi
  die "runtime install is stale or incomplete; rerun the launcher with --build"
}

ninfer_manager_command() {
  NINFER_MANAGER_COMMAND=(
    python3
    "${ROOT_DIR}/scripts/ninfer_runtime_manager.py"
  )
  local env_file
  for env_file in "${ENV_FILES[@]}"; do
    NINFER_MANAGER_COMMAND+=(--env-file "${env_file}")
  done
}

ninfer_manager_url() {
  ninfer_manager_command
  "${NINFER_MANAGER_COMMAND[@]}" --print-base-url
}

ninfer_manager_ready() {
  local base_url="$1"
  python3 - "${base_url}" <<'PY'
import json
import sys
from urllib.error import URLError
from urllib.request import urlopen

try:
    with urlopen(f"{sys.argv[1]}/health", timeout=1.0) as response:
        payload = json.loads(response.read().decode("utf-8"))
except (OSError, URLError, ValueError):
    raise SystemExit(1)
raise SystemExit(
    0
    if payload.get("service") == "taskplanner-ninfer-manager"
    else 1
)
PY
}

ensure_ninfer_model_loaded() {
  local model_id="${TASKPLANNER_NINFER_AUTOLOAD_MODEL_ID:-}"
  [[ -n "${model_id}" ]] || return 0
  if [[ "${DRY_RUN}" == "true" ]]; then
    print_command ensure-ninfer-model-loaded "${model_id}"
    return 0
  fi

  local container_id
  container_id="$(
    docker ps \
      --filter label=com.docker.compose.project=taskplanner_ws \
      --filter label=com.docker.compose.service=ninfer-manager \
      --filter status=running \
      --format '{{.ID}}' | head -n 1
  )"
  [[ -n "${container_id}" ]] || die "NInfer manager container is not running"

  # Execute inside the manager container so its configured API credential is
  # never copied into a shell command or printed.  The lifecycle API is
  # idempotent for the selected model and returns `loading` immediately.  In
  # particular, never wait for GPU/model warm-up here: the core, ASR, and UI
  # must remain usable while the provider catalog reports a degraded/loading
  # VLM state.
  docker exec -i "${container_id}" python3 - "${model_id}" <<'PY'
import json
import os
import sys
from urllib.error import HTTPError, URLError
from urllib.request import Request, urlopen

model_id = sys.argv[1]
port = int(os.environ.get("NINFER_MANAGER_PORT", "8080"))
root = f"http://127.0.0.1:{port}"
api_key = os.environ.get("NINFER_API_KEY", "").strip()
headers = {"Content-Type": "application/json"}
if api_key:
    headers["Authorization"] = f"Bearer {api_key}"


def request(path: str, *, payload: dict[str, str] | None = None) -> dict:
    data = None if payload is None else json.dumps(payload).encode("utf-8")
    req = Request(root + path, data=data, headers=headers)
    try:
        with urlopen(req, timeout=10.0) as response:
            body = json.loads(response.read().decode("utf-8"))
    except HTTPError as exc:
        detail = exc.read().decode("utf-8", errors="replace")
        raise SystemExit(f"NInfer lifecycle request failed ({exc.code}): {detail}")
    except (OSError, URLError, ValueError) as exc:
        raise SystemExit(f"NInfer lifecycle request failed: {exc}")
    if not isinstance(body, dict):
        raise SystemExit("NInfer lifecycle response is not a JSON object")
    return body


def model_states() -> dict[str, str]:
    payload = request("/manager/status")
    return {
        str(entry.get("id", "")): str(entry.get("state", ""))
        for entry in payload.get("models", [])
        if isinstance(entry, dict)
    }


states = model_states()
if model_id not in states:
    raise SystemExit(f"NInfer model is not installed/configured: {model_id}")
busy = {
    other_id: state
    for other_id, state in states.items()
    if other_id != model_id and state in {"loading", "loaded", "unloading"}
}
if busy:
    raise SystemExit(f"another NInfer model owns the runtime: {busy}")
if states[model_id] == "unloading":
    raise SystemExit(f"NInfer model is still unloading: {model_id}")
if states[model_id] == "loaded":
    print(f"NInfer model already ready: {model_id}")
    raise SystemExit(0)

response = request("/manager/load", payload={"model_id": model_id})
state = str(response.get("state", ""))
if state not in {"loading", "loaded"}:
    raise SystemExit(
        "NInfer model load was not accepted: "
        + str(response.get("detail", state or "unknown state"))
    )
print(f"NInfer model load requested ({state}): {model_id}")
PY
}

user_systemd_available() {
  command -v systemd-run >/dev/null 2>&1 &&
    systemctl --user show-environment >/dev/null 2>&1
}

runtime_control_ready() {
  local expected_fingerprint="${1:-}"
  python3 - "${RUNTIME_CONTROL_PORT}" "${expected_fingerprint}" <<'PY'
import json
import sys
from urllib.error import URLError
from urllib.request import urlopen

try:
    port = int(sys.argv[1])
    expected_fingerprint = sys.argv[2]
    with urlopen(f"http://127.0.0.1:{port}/health", timeout=1.0) as response:
        payload = json.loads(response.read().decode("utf-8"))
except (OSError, URLError, ValueError):
    raise SystemExit(1)
raise SystemExit(
    0
    if (
        payload.get("service") == "taskplanner-runtime-control"
        and payload.get("ready") is True
        and (
            not expected_fingerprint
            or payload.get("code_fingerprint") == expected_fingerprint
        )
    )
    else 1
)
PY
}

ensure_runtime_control_token() {
  if [[ "${DRY_RUN}" == "true" ]]; then
    return 0
  fi
  python3 - "${RUNTIME_CONTROL_TOKEN_FILE}" <<'PY'
import os
import secrets
import stat
import sys
from pathlib import Path

path = Path(sys.argv[1])
path.parent.mkdir(parents=True, exist_ok=True)
try:
    entry = path.lstat()
except FileNotFoundError:
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    flags |= getattr(os, "O_NOFOLLOW", 0)
    try:
        descriptor = os.open(path, flags, 0o600)
    except OSError as error:
        raise SystemExit(f"cannot create runtime-control token: {error}")
    with os.fdopen(descriptor, "w", encoding="utf-8") as output:
        output.write(secrets.token_urlsafe(32) + "\n")
    raise SystemExit(0)

if not stat.S_ISREG(entry.st_mode) or entry.st_uid != os.getuid():
    raise SystemExit("runtime-control token must be a regular file owned by the current user")
if entry.st_size < 32:
    raise SystemExit("runtime-control token is empty or invalid")
os.chmod(path, 0o600)
PY
}

write_active_runtime_mode() {
  local mode="$1"
  if [[ "${DRY_RUN}" == "true" ]]; then
    return 0
  fi
  python3 - "${RUNTIME_CONTROL_STATE_FILE}" "${mode}" <<'PY'
import json
import os
import sys
import tempfile
from pathlib import Path

path = Path(sys.argv[1])
mode = sys.argv[2]
path.parent.mkdir(parents=True, exist_ok=True)
descriptor, temporary = tempfile.mkstemp(prefix="active-runtime-mode.", dir=path.parent)
try:
    with os.fdopen(descriptor, "w", encoding="utf-8") as output:
        json.dump({"mode": mode}, output, separators=(",", ":"))
        output.write("\n")
        output.flush()
        os.fsync(output.fileno())
    os.chmod(temporary, 0o600)
    os.replace(temporary, path)
finally:
    try:
        os.unlink(temporary)
    except FileNotFoundError:
        pass
PY
}

clear_active_runtime_mode() {
  if [[ "${DRY_RUN}" == "true" ]]; then
    return 0
  fi
  rm -f -- "${RUNTIME_CONTROL_STATE_FILE}"
}

runtime_control_pid_matches() {
  local pid="$1"
  [[ "${pid}" =~ ^[0-9]+$ && -r "/proc/${pid}/cmdline" ]] || return 1
  local command_line
  command_line="$(tr '\0' ' ' <"/proc/${pid}/cmdline")"
  [[ "${command_line}" == *"${ROOT_DIR}/scripts/taskplanner_runtime_control.py"* ]]
}

stop_runtime_control_service() {
  if [[ "${DRY_RUN}" == "true" ]]; then
    print_command systemctl --user stop "${RUNTIME_CONTROL_UNIT}"
    print_command rm -f "${RUNTIME_CONTROL_PID_FILE}"
    return 0
  fi
  if user_systemd_available; then
    systemctl --user stop "${RUNTIME_CONTROL_UNIT}" >/dev/null 2>&1 || true
  fi
  if [[ -f "${RUNTIME_CONTROL_PID_FILE}" ]]; then
    local pid
    pid="$(cat "${RUNTIME_CONTROL_PID_FILE}")"
    if runtime_control_pid_matches "${pid}"; then
      kill "${pid}" >/dev/null 2>&1 || true
    fi
    rm -f -- "${RUNTIME_CONTROL_PID_FILE}"
  fi
}

ensure_runtime_control_service() {
  if [[ "${DRY_RUN}" == "true" ]]; then
    return 0
  fi
  [[ "${RUNTIME_CONTROL_PORT}" =~ ^[0-9]+$ ]] ||
    die "TASKPLANNER_RUNTIME_CONTROL_PORT must be a numeric loopback port"
  (( RUNTIME_CONTROL_PORT >= 1024 && RUNTIME_CONTROL_PORT <= 65535 )) ||
    die "TASKPLANNER_RUNTIME_CONTROL_PORT must be between 1024 and 65535"
  ensure_runtime_control_token
  local expected_fingerprint
  expected_fingerprint="$(sha256sum "${ROOT_DIR}/scripts/taskplanner_runtime_control.py" | awk '{print $1}')"
  if runtime_control_ready "${expected_fingerprint}"; then
    return 0
  fi

  # A controller-launched transition is still owned by the currently loaded
  # controller process. Never kill that supervisor from its child launcher.
  # A later explicit launcher/runtime-control invocation performs the idle
  # handoff to the new fingerprint.
  if [[ "${TASKPLANNER_RUNTIME_CONTROL_CHILD:-}" == "1" ]] && runtime_control_ready; then
    return 0
  fi

  stop_runtime_control_service
  mkdir -p "${RUNTIME_DIR}"
  local -a command=(
    python3
    "${ROOT_DIR}/scripts/taskplanner_runtime_control.py"
    --root "${ROOT_DIR}"
    --token-file "${RUNTIME_CONTROL_TOKEN_FILE}"
    --state-file "${RUNTIME_CONTROL_STATE_FILE}"
    --launcher-log-file "${RUNTIME_CONTROL_LAUNCH_LOG_FILE}"
    --bind-address 127.0.0.1
    --port "${RUNTIME_CONTROL_PORT}"
    --transition-timeout-sec "${RUNTIME_CONTROL_TRANSITION_TIMEOUT_SEC}"
    --rosbridge-router-port "${ROSBRIDGE_DEBUG_PORT:-9091}"
    --rosbridge-live-path "${VITE_ROSBRIDGE_LIVE_TAILSCALE_PATH:-/live}"
    --rosbridge-llm-path "${VITE_ROSBRIDGE_LLM_TAILSCALE_PATH:-/llm}"
    --rosbridge-replay-path "${VITE_ROSBRIDGE_SHADOW_TAILSCALE_PATH:-/shadow}"
  )
  if user_systemd_available; then
    systemd-run --user \
      --unit="${RUNTIME_CONTROL_UNIT%.service}" \
      --collect \
      --property=Restart=on-failure \
      --property=RestartSec=2 \
      "${command[@]}" >/dev/null
  else
    (
      umask 077
      nohup "${command[@]}" >>"${RUNTIME_CONTROL_LOG_FILE}" 2>&1 &
      printf '%s\n' "$!" >"${RUNTIME_CONTROL_PID_FILE}"
    )
  fi

  local attempt
  for attempt in $(seq 1 50); do
    if runtime_control_ready "${expected_fingerprint}"; then
      return 0
    fi
    sleep 0.1
  done
  die "runtime-control service did not become ready on 127.0.0.1:${RUNTIME_CONTROL_PORT}"
}

ensure_runtime_control_service_best_effort() {
  # The browser's local mode-control API is a convenience owner, not a
  # prerequisite for bringing up the ROS owner plane. Keep the explicit
  # runtime-control command strict, but let a cold Live/LLM start continue
  # when a stale token, loopback service, or user-systemd issue prevents this
  # optional UI helper from starting.
  if ! ( ensure_runtime_control_service ); then
    printf 'warning: runtime-control UI helper is unavailable; owner runtime continues and can be controlled from the shell\n' >&2
  fi
}

compose_environment_value() {
  local profile="$1"
  local service="$2"
  local key="$3"
  local fallback="$4"
  local -a profile_args=(--profile "${profile}")
  case "${service}" in
    taskplanner-state-core|taskplanner-command|taskplanner-tool-state|taskplanner-perception|taskplanner-cam4-mayo|taskplanner-projection|taskplanner-execution|taskplanner-operator-bridge|taskplanner-scenario|taskplanner-simulation-input|taskplanner-surgery-record|taskplanner-rosbag-recorder|taskplanner-debug-observer|taskplanner-debug-control|taskplanner-debug-virtual)
      profile_args+=(--profile owners)
      ;;
  esac
  "${COMPOSE[@]}" "${profile_args[@]}" config --format json |
    python3 -c '
import json
import sys

profile, service, key, fallback = sys.argv[1:]
config = json.load(sys.stdin)
print(
    config.get("services", {})
    .get(service, {})
    .get("environment", {})
    .get(key, fallback)
)
' "${profile}" "${service}" "${key}" "${fallback}"
}

perception_start_plan_error() {
  printf '%s\n' "$*" >&2
  return 1
}

resolve_optional_perception_start_plan() {
  # This only chooses optional local sidecars. It intentionally does not read
  # token files or hash model assets: the selected perception bridge/worker
  # validates those at its own boundary. A bad optional selection therefore
  # cannot delay or block state, command, execution, or bridge owners.
  local mode="$1"

  if [[ "${mode}" == "live" || "${mode}" == "replay" ]]; then
    perception_mode_enabled="true"
  elif [[ "${mode}" == "debug" ]]; then
    # Debug observation is deliberately self-contained.  Its two owners do
    # not start a PNU/VLM/camera worker as an accidental side effect of merely
    # opening a debugging surface.
    return 0
  fi

  [[ "${perception_mode_enabled}" == "true" ]] || return 0

  perception_backend="$(
    compose_environment_value \
      "${mode}" "${perception_consumer_service}" PERCEPTION_BACKEND local
  )" || return 1
  case "${perception_backend}" in
    local|external|disabled) ;;
    *)
      perception_start_plan_error \
        "PERCEPTION_BACKEND must resolve to local, external, or disabled"
      return 1
      ;;
  esac
  perception_provider="$(
    compose_environment_value \
      "${mode}" "${perception_consumer_service}" PERCEPTION_PROVIDER ""
  )" || return 1
  perception_location="$(
    compose_environment_value \
      "${mode}" "${perception_consumer_service}" PERCEPTION_LOCATION ""
  )" || return 1
  if [[ -z "${perception_provider}" ]]; then
    perception_selection_source="legacy_backend"
    if [[ -n "${perception_location}" ]]; then
      perception_start_plan_error \
        "PERCEPTION_LOCATION requires PERCEPTION_PROVIDER when using the legacy PERCEPTION_BACKEND fallback"
      return 1
    fi
    case "${perception_backend}" in
      local)
        perception_provider="builtin_rfdetr"
        perception_location="local"
        ;;
      external)
        perception_provider="pnu_hand_blood"
        perception_location="remote"
        ;;
      disabled)
        perception_provider="disabled"
        perception_location="local"
        ;;
    esac
  else
    case "${perception_provider}" in
      external_rfdetr_topics|builtin_rfdetr|pnu_hand_blood|disabled) ;;
      *)
        perception_start_plan_error \
          "PERCEPTION_PROVIDER must resolve to external_rfdetr_topics, builtin_rfdetr, pnu_hand_blood, or disabled"
        return 1
        ;;
    esac
    perception_location="${perception_location:-local}"
    case "${perception_location}" in
      local|remote) ;;
      *)
        perception_start_plan_error \
          "PERCEPTION_LOCATION must resolve to local or remote"
        return 1
        ;;
    esac
  fi

  # Endpoint, token, transport, and model identity checks deliberately stay in
  # bringup.perception_config and PNUPerceptionBridgeNode. They are meaningful
  # only to the owner that will use the connection and must not become a
  # launcher-wide cold-start gate.
  if [[ "${mode}" == "debug" && \
      "${perception_provider}" != "pnu_hand_blood" ]]; then
    perception_start_plan_error \
      "standalone Debug perception supports only PERCEPTION_PROVIDER=pnu_hand_blood"
    return 1
  fi

  local_rfdetr_enabled="$(
    compose_environment_value \
      "${mode}" "${perception_consumer_service}" \
      ENABLE_RFDETR_PERCEPTION false
  )" || return 1
  case "${local_rfdetr_enabled}" in
    true|false) ;;
    *)
      perception_start_plan_error \
        "ENABLE_RFDETR_PERCEPTION must resolve to true or false"
      return 1
      ;;
  esac
  if [[ "${perception_provider}" == "builtin_rfdetr" && \
      "${perception_location}" == "local" && \
      "${local_rfdetr_enabled}" == "true" ]]; then
    local_object_perception_enabled="true"
  fi
  if [[ "${perception_provider}" == "pnu_hand_blood" && \
      "${perception_location}" == "local" ]]; then
    local_pnu_perception_enabled="true"
  fi
}

endpoint_host_port() {
  python3 - "$1" "$2" <<'PY'
import sys
from urllib.parse import urlparse

parsed = urlparse(sys.argv[1])
host = parsed.hostname or "127.0.0.1"
port = parsed.port or int(sys.argv[2])
if host not in {"127.0.0.1", "localhost", "::1"}:
    raise SystemExit(1)
print(host, port)
PY
}

start_lmstudio_control_plane() {
  local mode="$1"
  local service="$2"
  local endpoint
  endpoint="$(
    compose_environment_value \
      "${mode}" "${service}" LMSTUDIO_BASE_URL http://127.0.0.1:1234
  )"
  local host_port
  host_port="$(endpoint_host_port "${endpoint}" 1234)" || return 0
  local host="${host_port% *}"
  local port="${host_port##* }"
  if curl -fsS --max-time 1 "${endpoint%/}/v1/models" >/dev/null 2>&1; then
    return 0
  fi
  command -v lms >/dev/null 2>&1 || return 1
  mkdir -p "${RUNTIME_DIR}"
  # acquire_launcher_lock uses a dynamic file descriptor.  LM Studio starts a
  # long-lived desktop service, so inheriting that descriptor would keep the
  # launcher lock held after this command returns and block every later
  # Taskplanner start/stop.  Close it only in the child process; the parent
  # still owns the lock for the rest of this transaction.
  (
    if [[ "${LAUNCHER_LOCK_FD:-}" =~ ^[0-9]+$ ]]; then
      eval "exec ${LAUNCHER_LOCK_FD}>&-"
    fi
    if user_systemd_available; then
      # lms launches a long-lived Electron service before its CLI exits. Put
      # that process tree in its own scope so restarting runtime-control cannot
      # also kill the model catalog server through cgroup ownership.
      systemctl --user stop "${LMSTUDIO_CONTROL_UNIT}" >/dev/null 2>&1 || true
      systemd-run --user --scope \
        --unit="${LMSTUDIO_CONTROL_UNIT%.scope}" \
        lms server start --port "${port}" --bind "${host}" >/dev/null
    else
      lms server start --port "${port}" --bind "${host}" >/dev/null
    fi
  )
  local attempt
  for attempt in $(seq 1 100); do
    if curl -fsS --max-time 1 "${endpoint%/}/v1/models" >/dev/null 2>&1; then
      printf '%s\n' "${endpoint}" >"${LMSTUDIO_STARTED_FILE}"
      return 0
    fi
    sleep 0.1
  done
  return 1
}

stop_lmstudio_control_plane() {
  [[ -f "${LMSTUDIO_STARTED_FILE}" ]] || return 0
  if command -v lms >/dev/null 2>&1; then
    lms server stop >/dev/null 2>&1 || true
  fi
  if user_systemd_available; then
    systemctl --user stop "${LMSTUDIO_CONTROL_UNIT}" >/dev/null 2>&1 || true
  fi
  rm -f "${LMSTUDIO_STARTED_FILE}"
}

start_unsloth_control_plane() {
  local mode="$1"
  local service="$2"
  local endpoint
  endpoint="$(
    compose_environment_value \
      "${mode}" "${service}" UNSLOTH_BASE_URL http://127.0.0.1:8888
  )"
  local host_port
  host_port="$(endpoint_host_port "${endpoint}" 8888)" || return 0
  local port="${host_port##* }"
  if curl -fsS --max-time 1 "${endpoint%/}/api/health" >/dev/null 2>&1; then
    return 0
  fi
  user_systemd_available || return 1
  local executable="${UNSLOTH_STUDIO_EXE:-${HOME}/.unsloth/studio/unsloth_studio/bin/unsloth}"
  [[ -x "${executable}" ]] || return 1
  systemctl --user stop "${UNSLOTH_CONTROL_UNIT}" >/dev/null 2>&1 || true
  systemd-run --user \
    --unit="${UNSLOTH_CONTROL_UNIT%.service}" \
    --collect \
    --property=Restart=no \
    "${executable}" studio -p "${port}" >/dev/null
  local attempt
  for attempt in $(seq 1 600); do
    if curl -fsS --max-time 1 "${endpoint%/}/api/health" >/dev/null 2>&1; then
      return 0
    fi
    if ! systemctl --user is-active --quiet "${UNSLOTH_CONTROL_UNIT}"; then
      break
    fi
    sleep 0.1
  done
  return 1
}

stop_unsloth_control_plane() {
  if user_systemd_available &&
      systemctl --user is-active --quiet "${UNSLOTH_CONTROL_UNIT}"; then
    systemctl --user stop "${UNSLOTH_CONTROL_UNIT}"
  fi
}

stop_legacy_ninfer_manager() {
  if [[ "${DRY_RUN}" == "true" ]]; then
    print_command systemctl --user stop "${NINFER_MANAGER_UNIT}"
    print_command rm -f "${NINFER_MANAGER_PID_FILE}"
    return 0
  fi
  if user_systemd_available &&
      systemctl --user is-active --quiet "${NINFER_MANAGER_UNIT}"; then
    systemctl --user stop "${NINFER_MANAGER_UNIT}"
  fi
  if [[ ! -f "${NINFER_MANAGER_PID_FILE}" ]]; then
    return 0
  fi
  local manager_pid
  manager_pid="$(cat "${NINFER_MANAGER_PID_FILE}")"
  if kill -0 "${manager_pid}" 2>/dev/null; then
    kill "${manager_pid}" 2>/dev/null || true
    local attempt
    for attempt in $(seq 1 100); do
      if ! kill -0 "${manager_pid}" 2>/dev/null; then
        break
      fi
      sleep 0.1
    done
  fi
  rm -f "${NINFER_MANAGER_PID_FILE}"
}

prepare_replay_run_root() {
  local run_root
  run_root="$(
    "${COMPOSE[@]}" --profile replay config --format json |
      python3 -c '
import json
import sys

config = json.load(sys.stdin)
for volume in config["services"]["shadow-runner"].get("volumes", []):
    if volume.get("type") == "bind" and volume.get("target") == "/taskplanner-runs":
        print(volume["source"])
        break
else:
    raise SystemExit("shadow-runner /taskplanner-runs bind mount is missing")
'
  )"

  if [[ "${DRY_RUN}" == "true" ]]; then
    print_command mkdir -p "${run_root}/shadow"
    return 0
  fi

  if mkdir -p "${run_root}/shadow" 2>/dev/null &&
      [[ -w "${run_root}/shadow" ]]; then
    return 0
  fi

  # Docker creates a missing bind source as root. Repair that one-time
  # bootstrap case without requiring sudo on a fresh deployment host.
  docker run --rm \
    --entrypoint bash \
    -v "${run_root}:/target" \
    taskplanner-ws:dev \
    -lc "mkdir -p /target/shadow && chown -R $(id -u):$(id -g) /target"

  [[ -w "${run_root}/shadow" ]] ||
    die "replay result directory is not writable: ${run_root}/shadow"
}

prepare_operational_asr_run_root() {
  local run_root
  run_root="$(
    "${COMPOSE[@]}" --profile live config --format json |
      python3 -c '
import json
import sys

config = json.load(sys.stdin)
for volume in config["services"]["taskplanner-asr"].get("volumes", []):
    if volume.get("type") == "bind" and volume.get("target") == "/taskplanner-runs":
        print(volume["source"])
        break
else:
    raise SystemExit("taskplanner-asr /taskplanner-runs bind mount is missing")
'
  )"

  if [[ "${DRY_RUN}" == "true" ]]; then
    print_command mkdir -p "${run_root}/asr"
    return 0
  fi
  mkdir -p "${run_root}/asr" 2>/dev/null ||
    die "ASR run directory cannot be created: ${run_root}/asr"
  [[ -w "${run_root}/asr" ]] ||
    die "ASR run directory is not writable by UID $(id -u): ${run_root}/asr"
}

prepare_vlm_reply_outbox_state() {
  local mode="$1"
  local state_root
  state_root="$(
    "${COMPOSE[@]}" --profile "${mode}" --profile owners config --format json |
      python3 -c '
import json
import sys

config = json.load(sys.stdin)
for volume in config["services"]["taskplanner-perception"].get("volumes", []):
    if volume.get("type") == "bind" and volume.get("target") == "/taskplanner-tts-state":
        print(volume["source"])
        break
else:
    raise SystemExit("taskplanner-perception /taskplanner-tts-state bind mount is missing")
'
  )"
  [[ -n "${state_root}" ]] ||
    die "cannot resolve the VLM reply outbox state directory"
  if [[ "${DRY_RUN}" == "true" ]]; then
    print_command install -d -m 0700 "${state_root}"
    return 0
  fi
  install -d -m 0700 "${state_root}" 2>/dev/null ||
    die "VLM reply outbox state directory cannot be created: ${state_root}"
  [[ -w "${state_root}" ]] ||
    die "VLM reply outbox state is not writable by UID $(id -u): ${state_root}"
}

