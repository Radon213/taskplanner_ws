# Required for Docker build. Use the local BT Ops checkout next to this repository.
BTOPS_LOCAL_CONTEXT=../btops_ws
BTOPS_REF=main
AUTO_APMS_REPO_URL=https://github.com/AutoAPMS/auto-apms.git
AUTO_APMS_REF=1.5.1

# ROS runtime defaults
ROS_DOMAIN_ID=0
ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST

# VLM defaults. Docker quickstart uses mock mode unless explicitly changed.
VLM_MODE=mock
VLM_BASE_URL=http://192.168.0.122:1234
VLM_MODEL_ID=gemma-4-e4b-it

# Web / rosbridge ports
WEBAPP_PORT=4173
ROSBRIDGE_PORT=9090
