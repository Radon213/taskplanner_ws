# Required for Docker build. Use the Git URL for the BT Ops dependency repository.
BTOPS_REPO_URL=git@github.com:Radon213/btops_ws.git
BTOPS_REF=main

# ROS runtime defaults
ROS_DOMAIN_ID=0
ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST

# VLM defaults. Docker quickstart uses mock mode unless explicitly changed.
VLM_MODE=mock
VLM_BASE_URL=http://192.168.0.122:1234
VLM_MODEL_ID=gemma-4-e4b-it

# Web / rosbridge ports
WEBAPP_PORT=4173
ROSBRIDGE_PORT=9090
