ROS_DOMAIN_ID=0
ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
CYCLONEDDS_URI=file:///workspaces/taskplanner_ws/config/cyclonedds_lan.xml

INPUT_PROFILE=external
# `taskplanner-runtime` is shared by Live and LLM Surgeon.  This explicit
# marker is required for a direct Compose deployment and is verified again by
# the container before it launches the Live preflight publisher.
TASKPLANNER_RUNTIME_MODE=live
EXECUTION_BACKEND=action
# Generic mock/replay default. Live intentionally does not read this legacy
# selector, so an operator cannot accidentally boot the ordinary thyroidectomy
# profile through an inherited environment.
TASKPLANNER_DEFAULT_BUNDLE=thyroidectomy
# Live default; an explicit `default_bundle:=...` launch argument remains the
# only supported override for the selected Live run.
TASKPLANNER_LIVE_DEFAULT_BUNDLE=thyroidectomy_demo
# Launch-lifetime selector: use `virtual` only for the isolated local
# Action/Service exercise route, then restart taskplanner-runtime. It never
# falls back to the physical `/surgery/*` controller names.
TASKPLANNER_LIVE_ROBOT_ENDPOINT_SOURCE=external
# Curated read-only state and stable compressed-camera aliases are on by
# default. An inactive scenario publishes empty/unknown state, not stale data.
PUBLISH_SHARED_STATE=true
PUBLISH_CAMERA_ALIASES=true
# Never enable by default: free-form transcript/summary fields require the
# receiving institutions and deployment owner to approve PHI handling first.
PUBLISH_SHARED_FREE_TEXT=false
PUBLIC_ROSBRIDGE_ALLOWED_ORIGINS=
PUBLIC_ROSBRIDGE_PORT=9092
ENABLE_PUBLIC_ROSBRIDGE=true
# The reviewed Live thyroidectomy demo requires source-stamped perception
# evidence at admission.  `voice_only` is Debug/replay-only and intentionally
# cannot satisfy the Live demo start gate.
VLM_MODE=real
SURGEON_ACTOR_MODE=none
ENABLE_NO_IMAGE_CAMERA=false
ENABLE_SYNTHETIC_SCENE_CAMERA=false

# Debug/replay compatibility only. taskplanner_live.launch.py fixes Live to the
# typed ASR chain below and never inherits SPEECH_INPUT_MODE/SENTENCE_INPUT_TOPIC.
SPEECH_INPUT_MODE=sentence_text
SENTENCE_INPUT_TOPIC=/sensors/surgeon/sentence
ASR_UTTERANCE_TOPIC=/sensors/surgeon/utterance
ASR_RUNTIME_STATUS_MAX_AGE_SEC=3.0
ASR_RUNTIME_STATUS_SOURCE_FUTURE_TOLERANCE_SEC=0.5
# Live-only USB microphone ASR producer. Keep credentials and query parameters
# out of this URL; the node rejects both. Ubuntu's selected PipeWire source is
# mounted by scripts/taskplanner, and the shared lock prevents double capture.
PUZZLE_ASR_URL=wss://arpa.worker-02.puzzle-ai.com
TASKPLANNER_PIPEWIRE_SOCKET=/run/user/1000/pipewire-0
TASKPLANNER_ASR_CAPTURE_LOCK=/taskplanner-runs/asr/microphone.lock

RFDETR_SERVICE_URL=http://127.0.0.1:8010
PERCEPTION_BACKEND=local
FLIR_INPUT_TOPIC=/synced/flir/color/image_raw/compressed
CAM3_INPUT_TOPIC=/synced/cam_3/color/image_raw/compressed
CAM4_INPUT_TOPIC=/synced/cam_4/color/image_raw/compressed
SEGMENTED_FLIR_TOPIC=/surgery/images/flir/segmented/compressed
CAM4_SEMANTICS_TOPIC=/surgery/perception/cam4/semantics/json
# These endpoints are monitored now but have no dummy publisher. The CV
# package, calibration, timing and ontology policies are installed on site.
CV_CONTRACT_STATUS_TOPIC=/integration/cv_contract/status
CV_CAM4_RGB_TOPIC=/synced/cam_4/color/image_raw/compressed
CV_CAM4_RGB_ALIAS_TOPIC=/surgery/images/cam4/compressed
CV_CAM4_CAMERA_INFO_TOPIC=/synced/cam_4/color/camera_info
CV_CAM4_ALIGNED_DEPTH_COMPRESSED_TOPIC=/synced/cam_4/aligned_depth_to_color/image_raw/compressedDepth
CV_CAM4_ALIGNED_DEPTH_CAMERA_INFO_TOPIC=/synced/cam_4/aligned_depth_to_color/camera_info
CV_HANDOVER_TRAY_RGB_TOPIC=/surgery/images/tray/compressed
CV_HANDOVER_TRAY_CAMERA_INFO_TOPIC=/surgery/cameras/tray/color/camera_info
CV_HANDOVER_TRAY_ALIGNED_DEPTH_TOPIC=/surgery/cameras/tray/aligned_depth
