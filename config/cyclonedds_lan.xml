<?xml version="1.0" encoding="UTF-8"?>
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain Id="any">
    <General>
      <!-- This deployment's authoritative wired ROS interface. -->
      <Interfaces>
        <NetworkInterface name="enp13s0" multicast="true" />
      </Interfaces>
      <AllowMulticast>true</AllowMulticast>
      <!-- MaxMessageSize limits the complete UDP payload after Cyclone packs
           one or more DDSI fragments. 1450 bytes leaves IPv4/UDP headroom on
           a 1500-byte Ethernet MTU; apply the same profile to every LAN writer. -->
      <MaxMessageSize>1450B</MaxMessageSize>
      <MaxRexmitMessageSize>1450B</MaxRexmitMessageSize>
      <!-- Keep individual DDSI fragments small enough to fit with RTPS
           submessage overhead inside the payload ceiling above. -->
      <FragmentSize>1344B</FragmentSize>
    </General>
    <Discovery>
      <!-- Multicast remains enabled; fixed peers make discovery resilient when
           a partner switch suppresses multicast. Offline peers are retried. -->
      <Peers>
        <Peer Address="127.0.0.1" />
        <Peer Address="192.168.1.6" />
        <Peer Address="192.168.1.7" />
        <Peer Address="192.168.1.37" />
      </Peers>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>60</MaxAutoParticipantIndex>
    </Discovery>
    <Internal>
      <SocketReceiveBufferSize max="64MB" />
      <SocketSendBufferSize max="64MB" />
      <!-- A single participant receives five preview JPEG streams plus the
           1920x540 final overlay.  The Cyclone default of four incomplete
           BEST_EFFORT samples is too small when large frames are fragmented;
           keep a bounded pool so one delayed sample does not stall every
           following latest-frame stream. -->
      <DefragUnreliableMaxSamples>64</DefragUnreliableMaxSamples>
      <Watermarks>
        <WhcHigh>4MB</WhcHigh>
      </Watermarks>
    </Internal>
    <Tracing>
      <Verbosity>warning</Verbosity>
      <OutputFile>stderr</OutputFile>
    </Tracing>
  </Domain>
</CycloneDDS>
