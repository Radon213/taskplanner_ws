# Replay-only profile for operative-note AI input generation.
# Override SHADOW_DATASET_ROOT in the shell or deployment environment when the
# external replay dataset is mounted elsewhere.

SHADOW_DATASET_ROOT="${SHADOW_DATASET_ROOT:-${HOME}/.local/share/taskplanner/datasets/shadow}"
SHADOW_CASE_ID=0704_6
SHADOW_BUNDLE_ID=thyroidectomy_demo
SHADOW_REQUIRE_VLM=true
SHADOW_REPLAY_MODE=elastic_demo
SHADOW_REPLAY_RATE=1.0

# The interactive replay service keeps its normal domain. The isolated,
# auditable run below uses separate ROS resources to avoid graph collisions.
SHADOW_ROS_DOMAIN_ID=71
SURGERY_RECORD_ROS_DOMAIN_ID=193
SURGERY_RECORD_ROSBRIDGE_PORT=9293

VLM_MODE=real
VLM_PROVIDER_ID=ninfer
VLM_BASE_URL=http://127.0.0.1:8080
VLM_MODEL_ID=qwen3.6-35b-a3b
VLM_API_MODE=openai_compat
VLM_RESPONSE_FORMAT=json_schema
VLM_REASONING_EFFORT=none
VLM_CONTEXT_MODE=actor_log
VLM_MAX_OUTPUT_TOKENS=320
VLM_GENERATION_SEED=0
VLM_PUBLISH_PERIOD_SEC=1.0

# Replay uses the source-bag surgeon transcript. No synthetic surgeon actor is
# part of this run.
SURGEON_ACTOR_MODE=none
