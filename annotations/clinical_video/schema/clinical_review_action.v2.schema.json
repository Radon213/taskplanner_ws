{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "taskplanner.clinical_review_action.v2",
  "title": "Append-only human action over an immutable clinical AI draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "case_id",
    "action_id",
    "annotation_id",
    "candidate_sha256",
    "supersedes_action_id",
    "client_request_id",
    "request_sha256",
    "review_status",
    "resulting_authority",
    "adjudicated_annotation",
    "review"
  ],
  "properties": {
    "schema": {
      "const": "taskplanner.clinical_review_action.v2"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "action_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+-CLH[0-9]{4,}$"
    },
    "annotation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+-CLV2-[0-9]{4,}$"
    },
    "candidate_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "supersedes_action_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9_-]+-CLH[0-9]{4,}$"
    },
    "client_request_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 200
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "review_status": {
      "enum": [
        "confirmed",
        "ambiguous",
        "rejected"
      ]
    },
    "resulting_authority": {
      "const": "human_reviewed_ai_draft_not_automatic_ground_truth"
    },
    "adjudicated_annotation": {
      "$ref": "#/$defs/adjudicated_annotation"
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_kind",
        "reviewer_id",
        "reviewer_role",
        "reviewed_at",
        "notes"
      ],
      "properties": {
        "reviewer_kind": {
          "const": "human"
        },
        "reviewer_id": {
          "type": "string",
          "minLength": 1
        },
        "reviewer_role": {
          "enum": [
            "clinical_reviewer",
            "clinician",
            "surgeon"
          ]
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "confidence": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "enum": [
            "low",
            "medium",
            "high",
            "not_assessable"
          ]
        }
      ]
    },
    "adjudicated_annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "annotation_id",
        "case_id",
        "anchor_source_frame_idx",
        "anchor_sec",
        "evidence_start_source_frame_idx",
        "evidence_end_source_frame_idx",
        "evidence_start_sec",
        "evidence_end_sec",
        "observation",
        "interpretation",
        "confidence",
        "source_views",
        "provenance",
        "review_status"
      ],
      "properties": {
        "schema": {
          "const": "taskplanner.clinical_video_annotation.v2"
        },
        "annotation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+-CLV2-[0-9]{4,}$"
        },
        "case_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "anchor_source_frame_idx": {
          "type": "integer",
          "minimum": 0
        },
        "anchor_sec": {
          "type": "number",
          "minimum": 0
        },
        "evidence_start_source_frame_idx": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_end_source_frame_idx": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_start_sec": {
          "type": "number",
          "minimum": 0
        },
        "evidence_end_sec": {
          "type": "number",
          "minimum": 0
        },
        "observation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600,
          "pattern": "\\S"
        },
        "interpretation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600,
          "pattern": "\\S"
        },
        "supersedes_annotation_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+-CL[0-9]{4,}$"
          }
        },
        "confidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "observation",
            "interpretation"
          ],
          "properties": {
            "observation": {
              "$ref": "#/$defs/confidence"
            },
            "interpretation": {
              "$ref": "#/$defs/confidence"
            }
          }
        },
        "source_views": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "cam1",
              "cam2",
              "cam3",
              "cam4",
              "flir"
            ]
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "generator",
            "model",
            "generated_at",
            "authority"
          ],
          "properties": {
            "generator": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "generated_at": {
              "type": "string",
              "format": "date-time"
            },
            "authority": {
              "const": "ai_draft"
            },
            "source_annotation_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+-CL[0-9]{4,}$"
              }
            }
          }
        },
        "review_status": {
          "enum": [
            "confirmed",
            "ambiguous",
            "rejected"
          ]
        }
      }
    }
  }
}
