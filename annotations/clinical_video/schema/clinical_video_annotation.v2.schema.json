{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "taskplanner.clinical_video_annotation.v2",
  "title": "Clinical video annotation with two human-readable narrative fields",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "annotation_id",
    "case_id",
    "anchor_source_frame_idx",
    "anchor_sec",
    "evidence_start_source_frame_idx",
    "evidence_end_source_frame_idx",
    "evidence_start_sec",
    "evidence_end_sec",
    "observation",
    "interpretation",
    "confidence",
    "source_views",
    "provenance",
    "review_status"
  ],
  "properties": {
    "schema": {
      "const": "taskplanner.clinical_video_annotation.v2"
    },
    "annotation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+-CLV2-[0-9]{4,}$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "anchor_source_frame_idx": {
      "type": "integer",
      "minimum": 0
    },
    "anchor_sec": {
      "type": "number",
      "minimum": 0
    },
    "evidence_start_source_frame_idx": {
      "type": "integer",
      "minimum": 0
    },
    "evidence_end_source_frame_idx": {
      "type": "integer",
      "minimum": 0
    },
    "evidence_start_sec": {
      "type": "number",
      "minimum": 0
    },
    "evidence_end_sec": {
      "type": "number",
      "minimum": 0
    },
    "observation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600,
      "pattern": "\\S",
      "description": "One or two sentences limited to facts directly observable in the evidence window."
    },
    "interpretation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600,
      "pattern": "\\S",
      "description": "One or two sentences interpreting the observation without claiming unreviewed AI output as ground truth."
    },
    "supersedes_annotation_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+-CL[0-9]{4,}$"
      },
      "description": "Immutable audit mapping to one or more superseded v1 annotations."
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation",
        "interpretation"
      ],
      "properties": {
        "observation": {
          "$ref": "#/$defs/confidence"
        },
        "interpretation": {
          "$ref": "#/$defs/confidence"
        }
      }
    },
    "source_views": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "cam1",
          "cam2",
          "cam3",
          "cam4",
          "flir"
        ]
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "generator",
        "model",
        "generated_at",
        "authority"
      ],
      "properties": {
        "generator": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "authority": {
          "const": "ai_draft"
        },
        "source_annotation_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+-CL[0-9]{4,}$"
          }
        }
      }
    },
    "review_status": {
      "enum": [
        "needs_surgeon_review",
        "confirmed",
        "ambiguous",
        "rejected"
      ]
    },
    "clinical_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "candidate_sha256",
        "review_status",
        "resulting_authority",
        "reviewer_kind",
        "reviewer_id",
        "reviewer_role",
        "reviewed_at",
        "notes"
      ],
      "properties": {
        "action_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+-CLH[0-9]{4,}$"
        },
        "candidate_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "review_status": {
          "enum": [
            "confirmed",
            "ambiguous"
          ]
        },
        "resulting_authority": {
          "const": "human_reviewed_ai_draft_not_automatic_ground_truth"
        },
        "reviewer_kind": {
          "const": "human"
        },
        "reviewer_id": {
          "type": "string",
          "minLength": 1
        },
        "reviewer_role": {
          "enum": [
            "clinical_reviewer",
            "clinician",
            "surgeon"
          ]
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "confidence": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "enum": [
            "low",
            "medium",
            "high",
            "not_assessable"
          ]
        }
      ]
    }
  }
}
