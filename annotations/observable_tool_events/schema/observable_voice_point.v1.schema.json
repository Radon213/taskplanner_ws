{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "taskplanner.observable_voice_point.v1",
  "title": "Read-only source transcript point for annotation review context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "case_id",
    "event_id",
    "event_type",
    "time_sec",
    "end_sec",
    "text",
    "source_topic",
    "source_record_timestamp_ns",
    "source_message_index",
    "source_wav",
    "source_authority",
    "scoring_role"
  ],
  "properties": {
    "schema": {
      "const": "taskplanner.observable_voice_point.v1"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+-V[0-9]{4,}$"
    },
    "event_type": {
      "const": "voice_utterance"
    },
    "time_sec": {
      "type": "number",
      "minimum": 0
    },
    "end_sec": {
      "type": "number",
      "minimum": 0
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "source_topic": {
      "const": "/surgery/transcript"
    },
    "source_record_timestamp_ns": {
      "type": "integer",
      "minimum": 0
    },
    "source_message_index": {
      "type": "integer",
      "minimum": 1
    },
    "source_wav": {
      "type": "string",
      "minLength": 1
    },
    "source_authority": {
      "const": "public_runtime_transcript"
    },
    "scoring_role": {
      "const": "context_only_not_ground_truth"
    }
  }
}
