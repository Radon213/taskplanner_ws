{
  "name": "taskplanner-digital-twin-webapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && node scripts/check-dev-server-contract.mjs && vite build && node scripts/check-bundle-budgets.cjs && node scripts/check-monitor-bundle.cjs",
    "check:domain-hardcoding": "node scripts/check-domain-hardcoding.cjs",
    "check:debug-safety": "node scripts/check-debug-safety.cjs",
    "check:live-asr-ui": "node scripts/check-live-asr-ui.cjs",
    "check:frontend-performance": "node scripts/check-frontend-performance.cjs",
    "check:monitor-bundle": "node scripts/check-monitor-bundle.cjs",
    "check:design-system": "node scripts/check-design-system.cjs",
    "check:dev-server-contract": "node scripts/check-dev-server-contract.mjs",
    "check:rosbridge-image-backpressure": "node scripts/check-rosbridge-image-backpressure.cjs",
    "test:monitor": "node --test monitor/test/*.test.js",
    "test:e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.31.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "roslib": "^1.4.1",
    "roslib-monitor": "npm:roslib@2.1.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.5",
    "playwright": "^1.62.1",
    "typescript": "^5.6.3",
    "vite": "^8.2.1"
  },
  "overrides": {
    "engine.io": "6.6.9",
    "socket.io-adapter": "2.5.8",
    "socket.io-parser": "4.2.7",
    "ws": "8.21.3"
  }
}
