# Mode-owned values. Shell environment variables can still override these.
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
CYCLONEDDS_URI=file:///workspaces/taskplanner_ws/config/cyclonedds_lan.xml
TASKPLANNER_CONTAINER_CYCLONEDDS_URI=file:///workspaces/taskplanner_ws/config/cyclonedds_lan.xml
INPUT_PROFILE=simulation
EXECUTION_BACKEND=mock
SURGEON_ACTOR_MODE=llm
VLM_MODE=real
ENABLE_NO_IMAGE_CAMERA=true
ENABLE_SYNTHETIC_SCENE_CAMERA=false
ENABLE_RFDETR_PERCEPTION=false
PERCEPTION_PROVIDER=disabled
PERCEPTION_LOCATION=local
PERCEPTION_ENDPOINT=
PERCEPTION_BACKEND=disabled
REQUIRE_PERCEPTION_ON_START=false
# The validation actor uses the no-image camera instead of RF-DETR. Feed that
# public camera stream into the same VLM field-input slot used by deployments.
SEGMENTED_FLIR_TOPIC=/surgery/images/field/compressed
ROSBRIDGE_PORT=9090
VITE_DEFAULT_RUNTIME_MODE=llm
ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET
ENABLE_PUBLIC_ROSBRIDGE=true
# Keep the LLM demonstration projection consistent with live/replay: this is
# an explicit development opt-in and does not change the safe template default.
PUBLISH_SHARED_FREE_TEXT=true
# 9091 is still the shared LAN/Tailnet path-router port. LLM Surgeon does not
# start the integration-debug observer; this only routes its own /llm bridge.
ROSBRIDGE_DEBUG_PORT=9091
ROSBRIDGE_DEBUG_UPSTREAM_PORT=9093
VITE_ROSBRIDGE_DEBUG_PORT=9091
VITE_ROSBRIDGE_LIVE_TAILSCALE_PORT=9091
VITE_ROSBRIDGE_LIVE_TAILSCALE_PATH=/live
VITE_ROSBRIDGE_TAILSCALE_PORT=9091
VITE_ROSBRIDGE_LLM_TAILSCALE_PATH=/llm
VITE_ROSBRIDGE_SHADOW_TAILSCALE_PATH=/shadow
TASKPLANNER_DEBUG_NETWORK_INTERFACE=enp13s0
VLLM_MANAGER_AUTO_START=false
