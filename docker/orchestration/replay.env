# Mode-owned values. Shell environment variables can still override these.
ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST
CYCLONEDDS_URI=
TASKPLANNER_CONTAINER_CYCLONEDDS_URI=
INPUT_PROFILE=external
EXECUTION_BACKEND=mock
SURGEON_ACTOR_MODE=none
VLM_MODE=real
VLM_BASE_URL=http://127.0.0.1:8080
VLM_PROVIDER_ID=ninfer
VLM_MODEL_ID=qwen3.6-35b-a3b
TASKPLANNER_NINFER_AUTOLOAD_MODEL_ID=qwen3.6-35b-a3b
LMSTUDIO_PROVIDER_ENABLED=false
UNSLOTH_PROVIDER_ENABLED=false
VLLM_PROVIDER_ENABLED=false
NINFER_PROVIDER_ENABLED=true
ENABLE_NO_IMAGE_CAMERA=false
ENABLE_SYNTHETIC_SCENE_CAMERA=false
ENABLE_RFDETR_PERCEPTION=true
# Replay input is independent of provider placement. Set the three explicit
# PERCEPTION_* axes together to exercise the same worker locally or over LAN;
# otherwise .env.example's legacy local RF-DETR mapping remains active.
REQUIRE_PERCEPTION_ON_START=false
SHADOW_CASE_ID=0704_6
SHADOW_BUNDLE_ID=thyroidectomy_demo
SHADOW_REQUIRE_VLM=false
SHADOW_REPLAY_MODE=elastic_demo
SHADOW_REPLAY_RATE=1.0
ROSBRIDGE_SHADOW_PORT=9099
# Keep the reviewed external state projection and read-only browser endpoint
# available in Replay exactly as they are in Live. The bridge must join the
# shadow runtime's isolated DDS domain, not the host's normal Domain 0 graph.
PUBLISH_SHARED_STATE=true
# Replay is the reviewed thyroidectomy demonstration surface; expose finalized
# speech/VLM free text through the public projection for the demo UI.
PUBLISH_SHARED_FREE_TEXT=true
PUBLIC_ROS_DOMAIN_ID=${SHADOW_ROS_DOMAIN_ID:-71}
PUBLIC_ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST
PUBLIC_CYCLONEDDS_URI=
PUBLIC_ROSBRIDGE_ALLOWED_ORIGINS=
PUBLIC_ROSBRIDGE_PORT=9092
ENABLE_PUBLIC_ROSBRIDGE=true
# The bounded SurgiMate UI-journal bridge must join the same isolated graph
# as the Replay public bridge, otherwise its recorded presentation events are
# invisible while replaying a manually captured MCAP.
ROSBAG_UI_AUDIT_ROS_DOMAIN_ID=${SHADOW_ROS_DOMAIN_ID:-71}
ROSBAG_UI_AUDIT_ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST
ROSBAG_UI_AUDIT_CYCLONEDDS_URI=
VITE_DEFAULT_RUNTIME_MODE=shadow
VITE_ROSBRIDGE_LIVE_TAILSCALE_PORT=9091
VITE_ROSBRIDGE_LIVE_TAILSCALE_PATH=/live
VITE_ROSBRIDGE_TAILSCALE_PORT=9091
VITE_ROSBRIDGE_LLM_TAILSCALE_PATH=/llm
VITE_ROSBRIDGE_SHADOW_TAILSCALE_PATH=/shadow
VLLM_MANAGER_AUTO_START=false
