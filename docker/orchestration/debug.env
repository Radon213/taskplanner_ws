# Scenario-free integration Debug Mode. It starts no BT, DT, VLM, surgeon
# actor, task planner, or physical-motion runtime. The read-only PNU CAM4
# evidence path is enabled separately below for visual inspection.
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
CYCLONEDDS_URI=file:///workspaces/taskplanner_ws/config/cyclonedds_lan.xml
TASKPLANNER_CONTAINER_CYCLONEDDS_URI=file:///workspaces/taskplanner_ws/config/cyclonedds_lan.xml
INPUT_PROFILE=external
EXECUTION_BACKEND=action
SURGEON_ACTOR_MODE=none
VLM_MODE=voice_only
ENABLE_RFDETR_PERCEPTION=false
ENABLE_PNU_DEBUG_PERCEPTION=true
PERCEPTION_PROVIDER=pnu_hand_blood
PERCEPTION_LOCATION=local
PERCEPTION_ENDPOINT=http://127.0.0.1:8020
PERCEPTION_BACKEND=external
# Tool, Blood, and Hand assets on this workstation are present and SHA-pinned.
# Keep bridge execution and Docker readiness on the same complete model set.
PNU_DEBUG_REQUESTED_ALGORITHMS=tool,blood,hand
PNU_WORKER_REQUIRED_ALGORITHMS=tool,blood,hand
# Pin every advertised model identity. The bridge rejects a capability response
# whose requested model digest differs from this reviewed set.
PNU_EXPECTED_MODEL_DIGESTS_JSON='{"tool":"253617aa5337fec219d694ca50537e4867fb8c403ce60f3a6945bbe15fecf430","blood":"f4967b2b8c7ab63921f8aa9b2ea0a4e3324243a9b98253da3ea4b9ecd6df6f75","hand":"fbc2a30080c3c557093b5ddfc334698132eb341044ccee322ccf8bcf3607cde1"}'
PNU_DEBUG_MAX_RATE_HZ=5.0
PNU_ALLOW_INSECURE_REMOTE_HTTP=false
PNU_ALLOW_UNAUTHENTICATED_REMOTE=false
CAM4_OVERLAY_TOPIC=/surgery/images/cam4/detection_overlay/compressed
CAM4_POSE_OVERLAY_TOPIC=/surgery/images/cam4/pose_overlay/compressed
# Reviewed VIPLab CAM4 D455 depth-to-color aligned stream contract.
PNU_DEPTH_SCALE_M_PER_UNIT=0.001
PNU_DEPTH_SCALE_VALIDATED=true
PNU_DEPTH_ALIGNMENT_VALIDATED=true
PNU_DEPTH_ALIGNMENT_ID=viplab-cam4-rgbd-align-v1-6af70cfd906e807f
# Multi-frame live CAM4 blue-tray plane. This is a camera-frame normal prior
# for Debug planar 4DoF only, never a robot/world/TCP calibration.
PNU_TOOL_SUPPORT_PLANE_NORMAL=0.046450707785,0.055576411879,-0.997373347443
PNU_TOOL_SUPPORT_PLANE_OFFSET_M=0.797796943113
PNU_TOOL_SUPPORT_PLANE_CONFIG_VERSION=viplab_cam4_146222251000_support_plane_v1_sha256_b683ecd5a5382a4f
PNU_TOOL_SUPPORT_PLANE_INLIER_RATIO=0.854928571429
PNU_TOOL_SUPPORT_PLANE_RESIDUAL_P95_M=0.014164174501
PNU_TOOL_SUPPORT_PLANE_VALIDATED=true
PNU_TOOL_SUPPORT_PLANE_ARTIFACT=/config/pnu_perception/cam4_support_plane_20260821.json
PNU_TOOL_SUPPORT_PLANE_ARTIFACT_SHA256=859fac1b528976a10ec9dbd67aa1baa979635d31dd944057e6e0c9594d9e68a2
PNU_TOOL_SUPPORT_PLANE_CAMERA_SERIAL=146222251000
PNU_TOOL_SUPPORT_PLANE_CAMERA_PROFILE='RGB 1280x720x15; depth 1280x720x15'
PNU_TOOL_SUPPORT_PLANE_FIRMWARE_VERSION=5.15.0.2
PNU_TOOL_SUPPORT_PLANE_MAX_AGE_DAYS=30
PNU_EXPECTED_TOOL_SUPPORT_PLANE_CONFIG_VERSION=viplab_cam4_146222251000_support_plane_v1_sha256_b683ecd5a5382a4f
ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET
ROSBRIDGE_DEBUG_PORT=9091
ROSBRIDGE_DEBUG_UPSTREAM_PORT=9093
WEBAPP_PORT=4173
VITE_DEFAULT_RUNTIME_MODE=debug
VITE_ROSBRIDGE_DEBUG_PORT=9091
VITE_ROSBRIDGE_LIVE_TAILSCALE_PORT=9091
VITE_ROSBRIDGE_LIVE_TAILSCALE_PATH=/live
VITE_ROSBRIDGE_TAILSCALE_PORT=9091
VITE_ROSBRIDGE_LLM_TAILSCALE_PATH=/llm
VITE_ROSBRIDGE_SHADOW_TAILSCALE_PATH=/shadow
# This workstation's Realtek 5GbE port used for partner LAN integration.
# The UI and LAN proxy must not silently substitute Wi-Fi or Tailscale when the
# cable is out.
TASKPLANNER_DEBUG_NETWORK_INTERFACE=enp13s0
# Standalone Debug Mode may edit and persist its own DDS network settings.
TASKPLANNER_DEBUG_LOCK_TO_RUNTIME_NETWORK=false
# Manual Debug commands are available only when the full planner runtime is
# stopped. Monitoring remains available while an operational runtime is active.
TASKPLANNER_DEBUG_ALLOW_PLANNER_COEXISTENCE=false
# Perception acceptance is monitor-only. Keep every Debug command endpoint on
# the virtual implementation even if a real LAN endpoint later becomes ready.
TASKPLANNER_DEBUG_ROBOT_ENDPOINT_SOURCE=virtual
TASKPLANNER_DEBUG_ROSBRIDGE_EXECUTABLE=secure_debug_rosbridge
TASKPLANNER_PIPEWIRE_SOCKET=/run/user/1000/pipewire-0
TASKPLANNER_SURGERY_RECORD_SOURCE_DIR=../taskplanner_ws/reports/surgery_records/0704_6_17_clinical_prompt_v1
PUZZLE_SURGERY_RECORD_API_KEY_FILE=/home/arl/.config/taskplanner/secrets/puzzle-surgery-record-api-key
PUZZLE_ASR_URL=wss://arpa.worker-02.puzzle-ai.com
PUZZLE_SURGERY_RECORD_ENDPOINT=https://dev.puzzle-ai.com:6627/api/v1/surgery/img_texts
