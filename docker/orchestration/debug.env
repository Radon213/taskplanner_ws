# Scenario-free integration Debug Mode. It intentionally starts no BT, DT,
# VLM, surgeon actor, perception service, or model control plane.
INPUT_PROFILE=external
EXECUTION_BACKEND=action
SURGEON_ACTOR_MODE=none
VLM_MODE=voice_only
ENABLE_RFDETR_PERCEPTION=false
ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET
ROSBRIDGE_DEBUG_PORT=9091
WEBAPP_PORT=4174
VITE_DEFAULT_RUNTIME_MODE=debug
VITE_ROSBRIDGE_DEBUG_PORT=9091
# This workstation's Realtek 5GbE port used for partner LAN integration.
# The UI and LAN proxy must not silently substitute Wi-Fi or Tailscale when the
# cable is out.
TASKPLANNER_DEBUG_NETWORK_INTERFACE=enp13s0
# This isolated integration workstation may acknowledge a paused partner planner
# for one manual-control session. Node-set changes still disarm immediately.
TASKPLANNER_DEBUG_ALLOW_PLANNER_COEXISTENCE=true
TASKPLANNER_PIPEWIRE_SOCKET=/run/user/1000/pipewire-0
TASKPLANNER_SURGERY_RECORD_SOURCE_DIR=../taskplanner_ws/reports/surgery_records/0704_6_17_clinical_prompt_v1
PUZZLE_SURGERY_RECORD_API_KEY_FILE=/home/arl/.config/taskplanner/secrets/puzzle-surgery-record-api-key
PUZZLE_ASR_URL=wss://arpa.worker-02.puzzle-ai.com
PUZZLE_SURGERY_RECORD_ENDPOINT=https://dev.puzzle-ai.com:6627/api/v1/surgery/img_texts
