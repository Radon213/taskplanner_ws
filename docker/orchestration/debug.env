# Scenario-free integration Debug Mode. It intentionally starts no BT, DT,
# VLM, surgeon actor, perception service, or model control plane.
INPUT_PROFILE=external
EXECUTION_BACKEND=action
SURGEON_ACTOR_MODE=none
VLM_MODE=voice_only
ENABLE_RFDETR_PERCEPTION=false
ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET
ROSBRIDGE_DEBUG_PORT=9091
WEBAPP_PORT=4174
VITE_DEFAULT_RUNTIME_MODE=debug
VITE_ROSBRIDGE_DEBUG_PORT=9091
