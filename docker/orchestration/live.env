# Mode-owned values. The launcher pins the core runtime contract even when a
# terminal carries stale mode variables from an earlier session.
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
CYCLONEDDS_URI=file:///workspaces/taskplanner_ws/config/cyclonedds_lan.xml
TASKPLANNER_CONTAINER_CYCLONEDDS_URI=file:///workspaces/taskplanner_ws/config/cyclonedds_lan.xml
INPUT_PROFILE=external
EXECUTION_BACKEND=action
TASKPLANNER_RUNTIME_MODE=live
SURGEON_ACTOR_MODE=none
VLM_MODE=real
ENABLE_NO_IMAGE_CAMERA=false
ENABLE_SYNTHETIC_SCENE_CAMERA=false
ENABLE_RFDETR_PERCEPTION=false
# Production never owns a detector process. It subscribes to the versioned,
# typed RF-DETR DDS frames published by the reviewed 192.168.1.7 runtime.
PERCEPTION_PROVIDER=external_rfdetr_topics
PERCEPTION_LOCATION=remote
PERCEPTION_ENDPOINT=
PERCEPTION_BACKEND=external
RFDETR_SERVICE_URL=
TASKPLANNER_RFDETR_SOURCE_HOST=192.168.1.7
REQUIRE_PERCEPTION_ON_START=false
ROSBRIDGE_PORT=9090
VITE_DEFAULT_RUNTIME_MODE=live
ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET
# Keep the read-only UI contract discoverable even before a scenario starts.
PUBLISH_SHARED_STATE=true
PUBLISH_CAMERA_ALIASES=true
# Demo operators need a read-only FLIR preview even while external robot
# preflight keeps the procedure run stopped. CAM4 remains active-run gated.
PUBLISH_FLIR_WHILE_IDLE=true
# The demonstration LAN is an explicitly reviewed development surface. Keep
# the contract's default redaction in .env.example, but publish finalized
# surgeon speech/VLM summaries for the live demo projection.
PUBLISH_SHARED_FREE_TEXT=true
PUBLIC_ROSBRIDGE_ALLOWED_ORIGINS=
PUBLIC_ROSBRIDGE_PORT=9092
ENABLE_PUBLIC_ROSBRIDGE=true
# The operational browser media plane is a separate loopback-only 9095 socket.
# It subscribes directly to the five existing Live compressed topics with
# latest-only egress; public 9092 and its LAN proxy do not expose these inputs.
ENABLE_LOCAL_MEDIA_ROSBRIDGE=true
LOCAL_MEDIA_ROSBRIDGE_PORT=9095
LOCAL_MEDIA_ROSBRIDGE_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
VITE_LIVE_MEDIA_BRIDGE_URL=
# Keep Production to one small core. Video/debug accessories remain opt-in;
# the independent TTS owner is always selected by Live and never blocks these
# control-plane owners if its local playback device is unavailable.
TASKPLANNER_LIVE_ENABLE_OPS=false
TASKPLANNER_LIVE_ENABLE_INTEGRATED_DEBUG=false
TASKPLANNER_LIVE_ENABLE_MULTICAM=false
TASKPLANNER_TTS_TOOL_ALIASES=
# Live owns the operational USB-microphone ASR sidecar. It publishes only
# server-finalized text on the same topic required by the runtime preflight.
PUZZLE_ASR_ENDPOINT=cloud
# Prefer the healthy USB-ASR LAN endpoint automatically for each new session;
# retain cloud as the reviewed fallback when the LAN health lease is stale.
TASKPLANNER_LIVE_ASR_ROUTE_POLICY=auto
PUZZLE_ASR_URL=wss://arpa.worker-02.puzzle-ai.com
PUZZLE_ASR_LAN_URL=ws://192.168.1.5:1196/
# Keep the established capture WebSocket across normal server-final frames.
# Set true only when explicitly comparing server-final rollover behavior.
TASKPLANNER_ASR_ROLLOVER_AFTER_FINAL=false
# Live never inherits Debug/replay's virtual endpoint selection. These IDs are
# retained for controller-side diagnostics only. Integration start and
# dispatch discover the selected Action and Service endpoints and never wait
# for a controller-contract publisher or validate its payload.
TASKPLANNER_LIVE_ROBOT_ENDPOINT_SOURCE=external
TASKPLANNER_LIVE_EXTERNAL_CONTROLLER_CONTRACT_ID=eir-nuc-tool-handover.real.v1
TASKPLANNER_LIVE_EXTERNAL_CAPABILITY_POLICY_ID=eir-nuc-tool-handover.v1
# Default the reviewed Live launch to the thyroidectomy demonstration.  The
# desktop clean-start launcher also exports this value so a stale shell cannot
# select a different bundle accidentally.
TASKPLANNER_LIVE_DEFAULT_BUNDLE=thyroidectomy_demo
# The dedicated Live record owner is unconditional. Voice and UI Stop share
# the same settled lifecycle receipt; natural Completed also submits once.
# Pause is non-terminal and preserves the current timeline.
PUZZLE_SURGERY_RECORD_ENDPOINT=https://192.168.1.5:6627/api/v1/surgery/img_texts
PUZZLE_SURGERY_RECORD_ROOM_NAME=Preclinical Center
TASKPLANNER_SURGERY_RECORD_PROCEDURES=thyroidectomy,thyroidectomy_demo
# The Live observation sidecar must never publish its no-motion emulator
# contract on the real NUC endpoints.
TASKPLANNER_DEBUG_ENABLE_VIRTUAL_ROBOT=false
TASKPLANNER_DEBUG_ROBOT_ENDPOINT_SOURCE=external
SENTENCE_INPUT_TOPIC=/sensors/surgeon/sentence
# Every camera consumer takes the VIPLab timestamp-preserving /synced contract.
# Do not fall back to native /camera or local /preview topics.
FLIR_INPUT_TOPIC=/synced/flir/color/image_raw/compressed
CAM3_INPUT_TOPIC=/synced/cam_3/color/image_raw/compressed
CAM4_INPUT_TOPIC=/synced/cam_4/color/image_raw/compressed
# RF-DETR tool authority is the typed DDS output from the reviewed 1.7 host.
# Production starts no HTTP bridge, model checkpoint, overlay detector, or
# local ROS adapter; VLM and preflight subscribe to these public facts directly.
CAM3_TOOL_OBSERVATIONS_TOPIC=/perception/cam_3/tool/observations
CAM4_TOOL_OBSERVATIONS_TOPIC=/perception/cam_4/tool/observations
# Empty means provenance is recorded but the producer-owned model label is not
# an admission pin. Set an exact value only for temporary incident isolation.
CAM3_TOOL_OBSERVATIONS_EXPECTED_MODEL_VERSION=
CAM4_TOOL_OBSERVATIONS_EXPECTED_MODEL_VERSION=
VITE_EXTERNAL_CAM1_TOPIC=/synced/cam_1/color/image_raw/compressed
VITE_EXTERNAL_CAM2_TOPIC=/synced/cam_2/color/image_raw/compressed
VITE_EXTERNAL_CAM3_OPERATOR_OVERLAY_TOPIC=/perception/cam_3/overlay/compressed
VITE_EXTERNAL_CAM4_OPERATOR_OVERLAY_TOPIC=/perception/cam_4/overlay/compressed
VITE_EXTERNAL_FLIR_TOPIC=/synced/flir/color/image_raw/compressed
# No checkpoint/ROI/threshold belongs to this consumer. Detector deployment
# geometry is owned and versioned on 192.168.1.7; this process validates only
# the public typed message and its required provenance metadata.
CV_CONTRACT_STATUS_TOPIC=/integration/cv_contract/status
CV_CAM4_RGB_TOPIC=/synced/cam_4/color/image_raw/compressed
CV_CAM4_RGB_ALIAS_TOPIC=/surgery/images/cam4/compressed
CV_CAM4_CAMERA_INFO_TOPIC=/synced/cam_4/color/camera_info
CV_CAM4_NATIVE_DEPTH_COMPRESSED_TOPIC=/synced/cam_4/depth/image_rect_raw/compressedDepth
CV_CAM4_DEPTH_CAMERA_INFO_TOPIC=/synced/cam_4/depth/camera_info
CV_CAM4_DEPTH_TO_COLOR_EXTRINSICS_TOPIC=/synced/cam_4/extrinsics/depth_to_color
CV_CAM4_ALIGNED_DEPTH_COMPRESSED_TOPIC=/synced/cam_4/aligned_depth_to_color/image_raw/compressedDepth
CV_CAM4_ALIGNED_DEPTH_CAMERA_INFO_TOPIC=/synced/cam_4/aligned_depth_to_color/camera_info
CV_HANDOVER_TRAY_RGB_TOPIC=/surgery/images/tray/compressed
CV_HANDOVER_TRAY_CAMERA_INFO_TOPIC=/surgery/cameras/tray/color/camera_info
CV_HANDOVER_TRAY_ALIGNED_DEPTH_TOPIC=/surgery/cameras/tray/aligned_depth
TASKPLANNER_ASR_CAPTURE_LOCK=/taskplanner-runs/asr/microphone.lock
# 9091 is the external Debug endpoint. Its service listens on the isolated
# loopback upstream so the path router can also serve Tailnet Live traffic.
ROSBRIDGE_DEBUG_PORT=9091
ROSBRIDGE_DEBUG_UPSTREAM_PORT=9093
VITE_ROSBRIDGE_DEBUG_PORT=9091
# Integrated Debug connects directly to the local observer upstream.  The
# optional 9091 router is for remote path-routed traffic and may be absent.
VITE_ROSBRIDGE_INTEGRATED_DEBUG_PORT=9093
# On a Tailnet IPv4 browser, tunnel the Live dashboard through the existing
# Tailnet-permitted port. The path-aware proxy forwards only this path to the
# loopback-only operational bridge; root traffic stays on Debug Mode.
VITE_ROSBRIDGE_LIVE_TAILSCALE_PORT=9091
VITE_ROSBRIDGE_LIVE_TAILSCALE_PATH=/live
# One Tailnet-local port is path-routed for every reviewed runtime mode. These
# values keep a remote dashboard on that route even while a profile switch is
# still recreating the webapp container.
VITE_ROSBRIDGE_TAILSCALE_PORT=9091
VITE_ROSBRIDGE_LLM_TAILSCALE_PATH=/llm
VITE_ROSBRIDGE_SHADOW_TAILSCALE_PATH=/shadow
TASKPLANNER_DEBUG_NETWORK_INTERFACE=enp13s0
TASKPLANNER_DEBUG_LOCK_TO_RUNTIME_NETWORK=true
TASKPLANNER_DEBUG_ALLOW_PLANNER_COEXISTENCE=false
TASKPLANNER_DEBUG_ROSBRIDGE_EXECUTABLE=secure_operational_debug_rosbridge
VLLM_MANAGER_AUTO_START=false
# Production has exactly one model authority. Alternative providers remain in
# Lab and cannot allocate a second model from a stale shell environment.
TASKPLANNER_START_LMSTUDIO_CONTROL_PLANE=false
TASKPLANNER_START_UNSLOTH_CONTROL_PLANE=false
LMSTUDIO_PROVIDER_ENABLED=false
UNSLOTH_PROVIDER_ENABLED=false
VLLM_PROVIDER_ENABLED=false
NINFER_PROVIDER_ENABLED=true
NINFER_PROVIDER_MANAGED=true
NINFER_MANAGER_ENABLED=true
TASKPLANNER_NINFER_AUTOLOAD_MODEL_ID=qwen3.6-35b-a3b
VLM_BASE_URL=http://127.0.0.1:8080
VLM_PROVIDER_ID=ninfer
VLM_MODEL_ID=qwen3.6-35b-a3b
