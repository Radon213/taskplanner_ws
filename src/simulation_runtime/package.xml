<?xml version="1.0"?>
<package format="3">
  <name>simulation_runtime</name>
  <version>0.1.0</version>
  <description>Simulation manager and mock surgeon runtime for taskplanner v1.</description>
  <maintainer email="Radon213@users.noreply.github.com">Radon213</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>btops_interfaces</exec_depend>
  <exec_depend>model_provider_registry</exec_depend>
  <exec_depend>procedure_spec</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>python3-requests</exec_depend>
  <exec_depend>surgical_interop_msgs</exec_depend>
  <exec_depend>surgical_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
