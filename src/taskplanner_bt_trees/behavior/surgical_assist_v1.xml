<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="TaskplannerAssistDemo">
  <BehaviorTree ID="TaskplannerAssistDemo">
    <KeepRunningUntilFailure>
      <Sequence name="TaskplannerAssistTick">
        <!-- RosSubscriberNode is success/failure-only.  The retry wrapper
             therefore needs one bounded yield when there is no sample; it is
             not a handover policy delay.  25 ms matches one 40 Hz executor
             period, prevents a busy-spin, and is skipped as soon as a fresh
             WorldState is available on the next tick. -->
        <RetryUntilSuccessful num_attempts="-1">
          <Delay delay_msec="25">
            <LoadWorldState />
          </Delay>
        </RetryUntilSuccessful>
        <IsProcedureActive />
        <Fallback name="DecisionRoot">
          <Sequence name="ExplicitRequest">
            <HasExplicitRequest />
            <SelectExplicitTool />
            <IsToolAvailable />
            <ApplyActionGuard />
            <CanHandover />
            <ConfigureHumanoidCommand
              decision="explicit_request"
              mode="explicit_request"
              rationale="explicit request selected"
            />
            <ForceSuccess>
              <Sequence name="RightHandHandover">
                <ShouldDispatchDecision />
                <EmitBTDecision />
                <PublishSkillCommand />
              </Sequence>
            </ForceSuccess>
          </Sequence>

          <Sequence name="DirectHandHandoverSignal">
            <Inverter>
              <HasExplicitRequest />
            </Inverter>
            <HasImplicitRequest />
            <SelectImplicitTool />
            <IsToolAvailable />
            <ApplyActionGuard />
            <CanHandover />
            <ConfigureHumanoidCommand
              decision="implicit_request"
              mode="implicit_request"
              rationale="BT accepted stable CAM4 Right Open_Palm PALM_UP signal"
            />
            <ForceSuccess>
              <Sequence name="ImplicitHandover">
                <ShouldDispatchDecision />
                <EmitBTDecision />
                <PublishSkillCommand />
              </Sequence>
            </ForceSuccess>
          </Sequence>

          <Sequence name="Recovery">
            <NeedsRecovery />
            <SelectRecoveryTool />
            <ConfigureHumanoidCommand
              decision="recovery"
              mode="recovery"
              rationale="BT recovery policy selected a verified Mayo tool"
            />
            <ForceSuccess>
              <Sequence name="LeftHandRecovery">
                <ShouldDispatchDecision />
                <EmitBTDecision />
                <PublishSkillCommand />
              </Sequence>
            </ForceSuccess>
          </Sequence>

          <Sequence name="AnticipatoryPreparation">
            <Inverter>
              <HasExplicitRequest />
            </Inverter>
            <Inverter>
              <NeedsRecovery />
            </Inverter>
            <SelectExpectedTool />
            <IsToolAvailable />
            <CanPreposition />
            <ConfigureHumanoidCommand
              decision="anticipatory_handover"
              mode="anticipatory"
              rationale="stable next-tool evidence selected for reversible preparation"
            />
            <ForceSuccess>
              <Sequence name="AnticipatoryHold">
                <ShouldDispatchDecision />
                <EmitBTDecision />
                <PublishSkillCommand />
              </Sequence>
            </ForceSuccess>
          </Sequence>

          <Sequence name="IdleObserve">
            <SetIdleDecision
              decision="idle"
              action=""
              rationale="no stronger branch selected"
            />
            <ForceSuccess>
              <Sequence name="IdleDecision">
                <ShouldDispatchDecision />
                <EmitBTDecision />
              </Sequence>
            </ForceSuccess>
          </Sequence>
        </Fallback>
      </Sequence>
    </KeepRunningUntilFailure>
  </BehaviorTree>
</root>
