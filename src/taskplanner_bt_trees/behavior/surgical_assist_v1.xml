<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="TaskplannerAssistDemo">
  <BehaviorTree ID="TaskplannerAssistDemo">
    <KeepRunningUntilFailure>
      <Sequence name="TaskplannerAssistTick">
        <RetryUntilSuccessful num_attempts="-1">
          <LoadWorldState />
        </RetryUntilSuccessful>
        <IsProcedureActive />
        <Fallback name="DecisionRoot">
          <Sequence name="ExplicitRequest">
            <HasExplicitRequest />
            <SelectExplicitTool />
            <IsToolAvailable />
            <ApplyActionGuard />
            <CanHandover />
            <ConfigureHumanoidCommand
              decision="explicit_request"
              mode="explicit_request"
              rationale="explicit request selected"
            />
            <ForceSuccess>
              <Sequence name="RightHandHandover">
                <ShouldDispatchDecision />
                <EmitBTDecision />
                <PublishSkillCommand />
              </Sequence>
            </ForceSuccess>
          </Sequence>

          <Sequence name="Safety">
            <Inverter>
              <IsPhaseCertain />
            </Inverter>
            <Inverter>
              <NeedsRecovery />
            </Inverter>
            <SetIdleDecision
              decision="hold"
              action=""
              rationale="phase uncertain; observing without robot motion"
            />
            <ForceSuccess>
              <Sequence name="SafetyDecision">
                <ShouldDispatchDecision />
                <EmitBTDecision />
              </Sequence>
            </ForceSuccess>
          </Sequence>

          <Sequence name="VisualImplicitRequest">
            <IsPhaseCertain />
            <Inverter>
              <HasExplicitRequest />
            </Inverter>
            <HasImplicitRequest />
            <SelectImplicitTool />
            <IsToolAvailable />
            <ApplyActionGuard />
            <CanHandover />
            <ConfigureHumanoidCommand
              decision="implicit_request"
              mode="implicit_request"
              rationale="BT accepted stable visual open-palm evidence"
            />
            <ForceSuccess>
              <Sequence name="ImplicitHandover">
                <ShouldDispatchDecision />
                <EmitBTDecision />
                <PublishSkillCommand />
              </Sequence>
            </ForceSuccess>
          </Sequence>

          <Sequence name="Recovery">
            <NeedsRecovery />
            <SelectRecoveryTool />
            <ConfigureHumanoidCommand
              decision="recovery"
              mode="recovery"
              rationale="BT recovery policy selected a verified Mayo tool"
            />
            <ForceSuccess>
              <Sequence name="LeftHandRecovery">
                <ShouldDispatchDecision />
                <EmitBTDecision />
                <PublishSkillCommand />
              </Sequence>
            </ForceSuccess>
          </Sequence>

          <Sequence name="AnticipatoryHandover">
            <IsPhaseCertain />
            <Inverter>
              <HasExplicitRequest />
            </Inverter>
            <Inverter>
              <NeedsRecovery />
            </Inverter>
            <SelectExpectedTool />
            <IsToolAvailable />
            <ApplyActionGuard />
            <CanHandover />
            <ConfigureHumanoidCommand
              decision="anticipatory_handover"
              mode="anticipatory"
              rationale="stable VLM next-tool prediction"
            />
            <ForceSuccess>
              <Sequence name="AnticipatoryHold">
                <ShouldDispatchDecision />
                <EmitBTDecision />
                <PublishSkillCommand />
              </Sequence>
            </ForceSuccess>
          </Sequence>

          <Sequence name="IdleObserve">
            <SetIdleDecision
              decision="idle"
              action=""
              rationale="no stronger branch selected"
            />
            <ForceSuccess>
              <Sequence name="IdleDecision">
                <ShouldDispatchDecision />
                <EmitBTDecision />
              </Sequence>
            </ForceSuccess>
          </Sequence>
        </Fallback>
      </Sequence>
    </KeepRunningUntilFailure>
  </BehaviorTree>
</root>
