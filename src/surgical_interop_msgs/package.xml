<?xml version="1.0"?>
<package format="3">
  <name>surgical_interop_msgs</name>
  <version>0.1.0</version>
  <description>Public ROS 2 interfaces for sharing safe surgical context and requesting focused robot capabilities.</description>
  <maintainer email="Radon213@users.noreply.github.com">Radon213</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>action_msgs</depend>
  <depend>builtin_interfaces</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
